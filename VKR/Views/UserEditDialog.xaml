<Window x:Class="VKR.Views.UserEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Пользователь"
        Width="640" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent" AllowsTransparency="True"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="InputBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="42"/>
        </Style>

        <Style x:Key="InputLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSubtleBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ShowPasswordButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeHoverSurfaceBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource ThemeSurfaceBrush}" CornerRadius="20" Margin="12"
            BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="{DynamicResource ThemeShadowColor}" BlurRadius="40"
                              ShadowDepth="12" Opacity="0.25"/>
        </Border.Effect>
        <StackPanel Margin="32">
            <Grid Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock x:Name="DialogTitleText" Text="Новый пользователь" FontSize="22"
                               FontWeight="ExtraBold" Foreground="{DynamicResource ThemeTextBrush}"/>
                    <TextBlock x:Name="DialogSubtitleText" Text="Логин, пароль, роль и контактные данные"
                               FontSize="13" Foreground="{DynamicResource ThemeTextMutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Width="32" Height="32" Background="{DynamicResource ThemeBgBrush}"
                        Foreground="{DynamicResource ThemeTextMutedBrush}" BorderThickness="0" Cursor="Hand"
                        Click="Cancel_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="14">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <StackPanel Margin="0,0,0,14">
                <TextBlock Text="ЛОГИН" Style="{StaticResource InputLabelStyle}"/>
                <Border Style="{StaticResource InputBorderStyle}">
                    <TextBox x:Name="LoginBox" BorderThickness="0" Background="Transparent"
                             VerticalContentAlignment="Center" Padding="12,0" FontSize="13"/>
                </Border>
                <TextBlock Text="Регистр не важен: admin и Admin — один и тот же логин."
                           FontSize="11" Foreground="{DynamicResource ThemeTextMutedBrush}"
                           Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="PasswordLabelText" Text="ПАРОЛЬ" Style="{StaticResource InputLabelStyle}"/>
                    <Border Style="{StaticResource InputBorderStyle}">
                        <Grid>
                            <PasswordBox x:Name="PasswordBox" BorderThickness="0" Background="Transparent"
                                         VerticalContentAlignment="Center" Padding="12,0,4,0" FontSize="13"/>
                            <TextBox x:Name="PasswordTextBox" BorderThickness="0" Background="Transparent"
                                     VerticalContentAlignment="Center" Padding="12,0,4,0" FontSize="13"
                                     Foreground="{DynamicResource ThemeTextBrush}"
                                     Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock x:Name="ConfirmPasswordLabelText" Text="ПОДТВЕРЖДЕНИЕ" Style="{StaticResource InputLabelStyle}"/>
                    <Border Style="{StaticResource InputBorderStyle}">
                        <Grid>
                            <PasswordBox x:Name="ConfirmPasswordBox" BorderThickness="0" Background="Transparent"
                                         VerticalContentAlignment="Center" Padding="12,0,4,0" FontSize="13"/>
                            <TextBox x:Name="ConfirmPasswordTextBox" BorderThickness="0" Background="Transparent"
                                     VerticalContentAlignment="Center" Padding="12,0,4,0" FontSize="13"
                                     Foreground="{DynamicResource ThemeTextBrush}"
                                     Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                </StackPanel>
                <Button Grid.Column="3" x:Name="ShowPasswordButton" Style="{StaticResource ShowPasswordButtonStyle}"
                        VerticalAlignment="Bottom" Margin="4,0,0,0"
                        Click="ShowPasswordButton_Click"
                        ToolTip="Показать или скрыть пароль">
                    <TextBlock x:Name="EyeIconText" Text="👁" FontSize="16"/>
                </Button>
            </Grid>
            <TextBlock x:Name="PasswordHintText" Text="Пароль: не менее 8 символов, буквы и цифры."
                       FontSize="11" Foreground="{DynamicResource ThemeTextMutedBrush}"
                       Margin="0,0,0,14" TextWrapping="Wrap"/>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="ФАМИЛИЯ" Style="{StaticResource InputLabelStyle}"/>
                    <Border Style="{StaticResource InputBorderStyle}">
                        <TextBox x:Name="LastNameBox" BorderThickness="0" Background="Transparent"
                                 VerticalContentAlignment="Center" Padding="12,0" FontSize="13"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="ИМЯ" Style="{StaticResource InputLabelStyle}"/>
                    <Border Style="{StaticResource InputBorderStyle}">
                        <TextBox x:Name="FirstNameBox" BorderThickness="0" Background="Transparent"
                                 VerticalContentAlignment="Center" Padding="12,0" FontSize="13"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="ОТЧЕСТВО" Style="{StaticResource InputLabelStyle}"/>
                    <Border Style="{StaticResource InputBorderStyle}">
                        <TextBox x:Name="MiddleNameBox" BorderThickness="0" Background="Transparent"
                                 VerticalContentAlignment="Center" Padding="12,0" FontSize="13"/>
                    </Border>
                </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="EMAIL" Style="{StaticResource InputLabelStyle}"/>
                    <Border Style="{StaticResource InputBorderStyle}">
                        <TextBox x:Name="EmailBox" BorderThickness="0" Background="Transparent"
                                 VerticalContentAlignment="Center" Padding="12,0" FontSize="13"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="РОЛЬ" Style="{StaticResource InputLabelStyle}"/>
                    <ComboBox x:Name="RoleCombo" DisplayMemberPath="RoleName"
                              SelectionChanged="RoleCombo_SelectionChanged"/>
                </StackPanel>
            </Grid>

            <StackPanel x:Name="TeacherPanel" Margin="0,0,0,14" Visibility="Collapsed">
                <TextBlock Text="КАРТОЧКА ПРЕПОДАВАТЕЛЯ" Style="{StaticResource InputLabelStyle}"/>
                <ComboBox x:Name="TeacherCombo" DisplayMemberPath="Name"/>
                <TextBlock Text="Привяжите учётную запись к карточке из раздела «Преподаватели»."
                           Foreground="{DynamicResource ThemeTextMutedBrush}"
                           FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <Border Background="{DynamicResource ThemeHoverSurfaceBrush}" CornerRadius="12" Padding="16,14"
                    BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Margin="0,0,0,14">
                <CheckBox x:Name="IsActiveCheck" Content="учётная запись активна"
                          IsChecked="True"/>
            </Border>

            <Border x:Name="ErrorBorder" Background="{DynamicResource ThemeDangerBgBrush}" CornerRadius="12"
                    Padding="14,10" Margin="0,4,0,0" Visibility="Collapsed">
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ThemeDangerFgBrush}"
                           FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Отмена" Width="120"
                        Style="{StaticResource DialogButtonStyle}"
                        Background="{DynamicResource ThemeSurfaceBrush}" Foreground="{DynamicResource ThemeTextBrush}"
                        BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                        Margin="0,0,8,0" Click="Cancel_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="14">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeBgBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="Сохранить" Width="140"
                        Style="{StaticResource DialogButtonStyle}"
                        Background="{DynamicResource ThemePrimaryBrush}" Foreground="{DynamicResource ThemeOnPrimaryBrush}"
                        Click="Save_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="14">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemePrimaryHoverBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
