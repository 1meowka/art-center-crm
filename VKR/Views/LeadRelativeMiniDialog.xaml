<Window x:Class="VKR.Views.LeadRelativeMiniDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Title="Родственник"
        Width="640" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent" AllowsTransparency="True"
        FontFamily="Segoe UI">
    <Border Background="{DynamicResource ThemeSurfaceBrush}" CornerRadius="20" Margin="12"
            BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Padding="28">
        <StackPanel>
            <TextBlock x:Name="DialogTitleText" Text="Новая карточка родственника"
                       FontSize="20" FontWeight="ExtraBold" Margin="0,0,0,6"/>
            <TextBlock x:Name="DialogHintText"
                       Text="У родственника появится своя карточка гостя. Данные уже созданной карточки здесь не меняются."
                       FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextMutedBrush}" Margin="0,0,0,16"/>

            <StackPanel x:Name="KindPanel" Orientation="Horizontal" Margin="0,0,0,14">
                <RadioButton x:Name="AdultRadio" Content="Взрослый" FontWeight="SemiBold" Margin="0,0,18,0"
                             Checked="Kind_Changed"/>
                <RadioButton x:Name="ChildRadio" Content="Ребёнок (брат / сестра)" FontWeight="SemiBold"
                             Checked="Kind_Changed"/>
            </StackPanel>

            <StackPanel x:Name="PersonPanel">
                <TextBlock Text="ФИО *" FontSize="11" FontWeight="Black" Foreground="{DynamicResource ThemeTextSubtleBrush}" Margin="0,0,0,6"/>
                <TextBox x:Name="FullNameBox" Height="40" Padding="12,0" VerticalContentAlignment="Center"
                         LostFocus="NameTextBox_LostFocus" Margin="0,0,0,12"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,0,12">
                        <TextBlock Text="ДАТА РОЖДЕНИЯ" FontSize="11" FontWeight="Black" Foreground="{DynamicResource ThemeTextSubtleBrush}" Margin="0,0,0,6"/>
                        <xctk:MaskedTextBox x:Name="BirthDateBox" Mask="00\.00\.0000" Height="40"
                                            Padding="12,0" VerticalContentAlignment="Center" PromptChar="_"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,0,12">
                        <TextBlock x:Name="PhoneLabel" Text="ТЕЛЕФОН *" FontSize="11" FontWeight="Black"
                                   Foreground="{DynamicResource ThemeTextSubtleBrush}" Margin="0,0,0,6"/>
                        <xctk:MaskedTextBox x:Name="PhoneBox" Mask="+7 (000) 000-00-00" Height="40"
                                            Padding="12,0" VerticalContentAlignment="Center" PromptChar="_"/>
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="WorkplacePanel" Margin="0,0,0,12">
                    <TextBlock Text="МЕСТО РАБОТЫ (необязательно)" FontSize="11" FontWeight="Black"
                               Foreground="{DynamicResource ThemeTextSubtleBrush}" Margin="0,0,0,6"/>
                    <TextBox x:Name="WorkplaceBox" Height="40" Padding="12,0" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel x:Name="InstitutionPanel" Margin="0,0,0,12" Visibility="Collapsed">
                    <TextBlock Text="УЧЕБНОЕ УЧРЕЖДЕНИЕ" FontSize="11" FontWeight="Black"
                               Foreground="{DynamicResource ThemeTextSubtleBrush}" Margin="0,0,0,6"/>
                    <ComboBox x:Name="InstitutionCombo" Height="40" FontSize="13"
                              DisplayMemberPath="Name" SelectedValuePath="Id"
                              IsEditable="True" IsTextSearchEnabled="False"
                              MaxDropDownHeight="280"
                              VerticalContentAlignment="Center"
                              ToolTip="Начните вводить название учреждения из справочника"/>
                </StackPanel>

                <TextBlock Text="АДРЕС ПРОЖИВАНИЯ" FontSize="11" FontWeight="Black"
                           Foreground="{DynamicResource ThemeTextSubtleBrush}" Margin="0,0,0,6"/>
                <TextBox x:Name="ResidenceAddressBox" MinHeight="52" MaxHeight="52" Padding="12,8"
                         TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Disabled"
                         Margin="0,0,0,12"/>
            </StackPanel>

            <TextBlock x:Name="ExistingNameText" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"
                       Visibility="Collapsed"/>

            <TextBlock x:Name="RelationLabel" Text="СТЕПЕНЬ РОДСТВА *" FontSize="11" FontWeight="Black"
                       Foreground="{DynamicResource ThemeTextSubtleBrush}" Margin="0,0,0,6"/>
            <ComboBox x:Name="RelationCombo" Height="40" Margin="0,0,0,12"
                      DisplayMemberPath="Name" SelectedValuePath="Id"
                      VerticalContentAlignment="Center"/>

            <Border x:Name="RolesPanel" Background="{DynamicResource ThemeHoverSurfaceBrush}" CornerRadius="12"
                    Padding="16,14" Margin="0,0,0,8">
                <StackPanel>
                    <CheckBox x:Name="MainPayerCheck" Content="Основной плательщик" Margin="0,0,0,8"/>
                    <CheckBox x:Name="LegalCheck" Content="Законный представитель"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="ErrorText" Foreground="#E11D48" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Отмена" Width="110" Height="40" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button Content="Сохранить" Width="130" Height="40" Click="Save_Click"
                        Background="{DynamicResource ThemePrimaryBrush}" Foreground="{DynamicResource ThemeOnPrimaryBrush}" BorderThickness="0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
