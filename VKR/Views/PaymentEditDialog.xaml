<Window x:Class="VKR.Views.PaymentEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:VKR.Views"
        Title="Оплата — Арт-студия"
        WindowState="Maximized"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        WindowStyle="None"
        Background="{DynamicResource ThemeBgBrush}"
        FontFamily="Segoe UI">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource ThemeHeaderBrush}"
                BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,0,1"
                Padding="16,12" MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid>
                <TextBlock x:Name="TitleText" Text="Новая оплата" FontSize="18" FontWeight="ExtraBold"
                           Foreground="{DynamicResource ThemeTextBrush}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Свернуть" Padding="12,6" FontWeight="Bold" Margin="0,0,8,0"
                            Click="Minimize_Click"/>
                    <Button Content="Закрыть" Padding="12,6" FontWeight="Bold"
                            Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        <views:PaymentEditPanel x:Name="Editor" Margin="24" VerticalAlignment="Stretch"/>
    </DockPanel>
</Window>
