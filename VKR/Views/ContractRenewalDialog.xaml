<Window x:Class="VKR.Views.ContractRenewalDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Продление договора"
        Width="620" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        FontFamily="Segoe UI">

    <Border Background="{DynamicResource ThemeSurfaceBrush}" CornerRadius="20" Margin="12"
            BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1">
        <StackPanel Margin="32">
            <TextBlock x:Name="TitleText" Text="Продление договора" FontSize="22" FontWeight="ExtraBold"
                       Foreground="{DynamicResource ThemeTextBrush}" Margin="0,0,0,4"/>
            <TextBlock x:Name="SubtitleText" FontSize="13" Foreground="{DynamicResource ThemeTextMutedBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,20"/>

            <TextBlock Text="РЕШЕНИЕ ПО ПРОДЛЕНИЮ" FontSize="11" FontWeight="Black"
                       Foreground="{DynamicResource ThemeTextSubtleBrush}" Margin="0,0,0,6"/>
            <ComboBox x:Name="DecisionComboBox" Height="42" FontSize="13" Margin="0,0,0,8">
                <ComboBoxItem Content="Не указано — только отметить задачу" IsSelected="True"/>
                <ComboBoxItem Content="Да, продлит договор"/>
                <ComboBoxItem Content="Нет, не продлит"/>
            </ComboBox>
            <TextBlock Text="Можно оставить «не указано», если связались с клиентом и просто закрываете задачу"
                       FontSize="10" FontStyle="Italic" Foreground="{DynamicResource ThemeTextSubtleBrush}"
                       Margin="2,0,0,16"/>

            <TextBlock Text="КОММЕНТАРИЙ" FontSize="11" FontWeight="Black"
                       Foreground="{DynamicResource ThemeTextSubtleBrush}" Margin="0,0,0,6"/>
            <Border Background="{DynamicResource ThemeSurfaceBrush}" CornerRadius="12"
                    BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Margin="0,0,0,16">
                <TextBox x:Name="CommentTextBox" Height="72" Padding="14,10" BorderThickness="0"
                         FontSize="13" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" Background="Transparent"/>
            </Border>

            <Border x:Name="ErrorBorder" Background="{DynamicResource ThemeDangerBgBrush}" CornerRadius="12"
                    Padding="14,10" Margin="0,0,0,12" Visibility="Collapsed">
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ThemeDangerFgBrush}"
                           FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" Width="110" Height="40" FontWeight="Bold" Margin="0,0,8,0"
                        Click="CancelButton_Click"/>
                <Button Content="✓  Задача выполнена" Height="40" Padding="16,0" FontWeight="Bold"
                        Background="{DynamicResource ThemePrimaryBrush}"
                        Foreground="{DynamicResource ThemeOnPrimaryBrush}"
                        Click="SaveButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
