<Window x:Class="VKR.Views.TrialLessonBookDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Title="Запись на пробное"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource ThemeBgBrush}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="InputLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSubtleBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource ThemeSurfaceBrush}" CornerRadius="0" Margin="0"
            BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0">

        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="420"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="420" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Запись на пробное занятие" FontSize="22" FontWeight="ExtraBold"/>
                    <TextBlock Text="Найдите карточку гостя, выберите направление, группу и преподавателя"
                               FontSize="13" Foreground="{DynamicResource ThemeTextMutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Width="32" Height="32" Background="{DynamicResource ThemeBgBrush}"
                        BorderThickness="0" Click="Cancel_Click"/>
            </Grid>

            <!-- Левая колонка — форма -->
            <ScrollViewer Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="ПОИСК КАРТОЧКИ ГОСТЯ" Style="{StaticResource InputLabelStyle}"/>
                    <TextBox x:Name="LeadSearchBox" Height="38" Padding="12,0"
                             VerticalContentAlignment="Center" FontSize="13"
                             TextChanged="LeadSearchBox_TextChanged"
                             ToolTip="ФИО ребёнка, клиента или телефон"/>

                    <StackPanel Margin="0,12,0,14">
                        <TextBlock Style="{StaticResource InputLabelStyle}">
                            <Run Text="КАРТОЧКА ГОСТЯ"/>
                        </TextBlock>
                        <ComboBox x:Name="LeadCombo" Height="42" FontSize="13"
                                  DisplayMemberPath="ChildFullName" SelectedValuePath="IdLead"
                                  SelectionChanged="LeadCombo_SelectionChanged"/>
                        <Button Content="➕  Создать новую карточку гостя" Margin="0,8,0,0"
                                HorizontalAlignment="Left" Style="{StaticResource SectionHeaderButtonStyle}"
                                Click="CreateLead_Click"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource InputLabelStyle}"><Run Text="ДАТА"/></TextBlock>
                            <DatePicker x:Name="ScheduledDatePicker" Height="42" FontSize="13"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource InputLabelStyle}"><Run Text="ВРЕМЯ НАЧАЛА"/></TextBlock>
                            <Border Background="{DynamicResource ThemeSurfaceBrush}" CornerRadius="12"
                                    BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Height="42">
                                <xctk:MaskedTextBox x:Name="StartTimeMaskedBox" Mask="00:00"
                                                    BorderThickness="0" Background="Transparent"
                                                    VerticalContentAlignment="Center" Padding="14,0" FontSize="13"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="ВРЕМЯ ОКОНЧАНИЯ (необязательно)" Style="{StaticResource InputLabelStyle}"/>
                        <Border Background="{DynamicResource ThemeSurfaceBrush}" CornerRadius="12"
                                BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Height="42">
                            <xctk:MaskedTextBox x:Name="EndTimeMaskedBox" Mask="00:00"
                                                BorderThickness="0" Background="Transparent"
                                                VerticalContentAlignment="Center" Padding="14,0" FontSize="13"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="НАПРАВЛЕНИЕ (необязательно)" Style="{StaticResource InputLabelStyle}"/>
                        <ComboBox x:Name="DirectionCombo" Height="42" FontSize="13"
                                  DisplayMemberPath="Name" SelectedValuePath="Id"
                                  SelectionChanged="DirectionCombo_SelectionChanged"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Style="{StaticResource InputLabelStyle}"><Run Text="ГРУППА"/></TextBlock>
                        <ComboBox x:Name="GroupCombo" Height="42" FontSize="13"
                                  DisplayMemberPath="ComboDisplay" SelectedValuePath="IdGroup"
                                  SelectionChanged="GroupCombo_SelectionChanged"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Style="{StaticResource InputLabelStyle}"><Run Text="ПРЕПОДАВАТЕЛЬ"/></TextBlock>
                        <ComboBox x:Name="TeacherCombo" Height="42" FontSize="13"
                                  DisplayMemberPath="Name" SelectedValuePath="Id"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Правая колонка — история -->
            <Border Grid.Row="1" Grid.Column="2" CornerRadius="16"
                    BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                    Background="{DynamicResource ThemeHoverSurfaceBrush}" Padding="16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="История пробных" FontSize="16" FontWeight="ExtraBold"/>
                        <TextBlock x:Name="TrialStatsText" FontSize="12"
                                   Foreground="{DynamicResource ThemeTextMutedBrush}"
                                   TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="Выберите карточку гостя"/>
                    </StackPanel>
                    <DataGrid x:Name="HistoryGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="None"
                              Background="Transparent" BorderThickness="0" FontSize="12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ДАТА" Binding="{Binding ScheduledText}" Width="110"/>
                            <DataGridTextColumn Header="ПРЕПОД." Binding="{Binding TeacherName}" Width="*"/>
                            <DataGridTextColumn Header="ИТОГ" Binding="{Binding ResultText}" Width="90"/>
                            <DataGridTextColumn Header="СВЯЗЬ" Binding="{Binding FeedbackDisplay}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Row="2" Grid.ColumnSpan="3" Background="#FFE066" CornerRadius="12"
                    Padding="14,10" Margin="0,16,0,0">
                <TextBlock FontSize="12" Foreground="{DynamicResource ThemeWarningFgBrush}" TextWrapping="Wrap"
                           Text="Справа — у кого уже были пробные, получена ли обратная связь и заключён ли договор."/>
            </Border>

            <Border Grid.Row="3" Grid.ColumnSpan="3" x:Name="ErrorBorder"
                    Background="{DynamicResource ThemeDangerBgBrush}" CornerRadius="12"
                    Padding="14,10" Margin="0,12,0,0" Visibility="Collapsed">
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ThemeDangerFgBrush}" TextWrapping="Wrap"/>
            </Border>

            <StackPanel Grid.Row="4" Grid.ColumnSpan="3" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Отмена" Width="120" Style="{StaticResource DialogButtonStyle}"
                        Background="{DynamicResource ThemeSurfaceBrush}" Margin="0,0,8,0"
                        Click="Cancel_Click"/>
                <Button Content="Записать →" Width="160" Style="{StaticResource DialogButtonStyle}"
                        Background="{DynamicResource ThemePrimaryBrush}"
                        Foreground="{DynamicResource ThemeOnPrimaryBrush}"
                        Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
