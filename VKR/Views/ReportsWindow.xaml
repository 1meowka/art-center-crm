<Window x:Class="VKR.Views.ReportsWindow"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="Отчёты — Арт-студия"

        WindowState="Maximized"

        WindowStyle="None"

        ResizeMode="CanResize"

        Background="{DynamicResource ThemeBgBrush}"

        FontFamily="Segoe UI">



    <Window.Resources>

        <Style x:Key="HeaderButtonStyle" TargetType="Button">

            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}"/>

            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>

            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>

            <Setter Property="BorderThickness" Value="1"/>

            <Setter Property="Padding" Value="14,9"/>

            <Setter Property="FontWeight" Value="Bold"/>

            <Setter Property="FontSize" Value="13"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Margin" Value="4,0"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="Bd"

                                Background="{TemplateBinding Background}"

                                BorderBrush="{TemplateBinding BorderBrush}"

                                BorderThickness="{TemplateBinding BorderThickness}"

                                CornerRadius="14"

                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeBgBrush}"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>



        <Style x:Key="ReportCardButtonStyle" TargetType="Button">

            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}"/>

            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>

            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>

            <Setter Property="BorderThickness" Value="1"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>

            <Setter Property="VerticalContentAlignment" Value="Stretch"/>

            <Setter Property="Padding" Value="0"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="Bd"

                                Background="{TemplateBinding Background}"

                                BorderBrush="{TemplateBinding BorderBrush}"

                                BorderThickness="{TemplateBinding BorderThickness}"

                                CornerRadius="28"

                                Padding="28">

                            <Border.Effect>

                                <DropShadowEffect Color="{DynamicResource ThemeShadowColor}"

                                                  BlurRadius="24"

                                                  ShadowDepth="8"

                                                  Opacity="0.06"/>

                            </Border.Effect>

                            <ContentPresenter/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeHoverSurfaceBrush}"/>

                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemePrimaryBrush}"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>



    <Grid>

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>



        <Border Grid.Row="0"

                Background="{DynamicResource ThemeSurfaceBrush}"

                BorderBrush="{DynamicResource ThemeBorderBrush}"

                BorderThickness="0,0,0,1">

            <Grid Margin="28,16,28,16">

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <Image Source="/Resources/logo.png" Width="44" Height="44" Margin="0,0,14,0"

                           RenderOptions.BitmapScalingMode="HighQuality"/>

                    <StackPanel VerticalAlignment="Center">

                        <TextBlock Text="ТЕКУЩИЙ РАЗДЕЛ" FontSize="11"

                                   FontWeight="Black" Foreground="{DynamicResource ThemeTextSubtleBrush}"/>

                        <TextBlock Text="Отчёты и выгрузки" FontSize="22"

                                   FontWeight="ExtraBold" Foreground="{DynamicResource ThemeTextBrush}" Margin="0,2,0,0"/>

                    </StackPanel>

                </StackPanel>



                <Button Content="← Назад"

                        Style="{StaticResource HeaderButtonStyle}"

                        HorizontalAlignment="Right"

                        VerticalAlignment="Center"

                        Click="CloseButton_Click"/>

            </Grid>

        </Border>



        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="28,24,28,32">

                <TextBlock Text="Выберите файл отчёта"

                           FontSize="28"

                           FontWeight="ExtraBold"

                           Foreground="{DynamicResource ThemeTextBrush}"

                           Margin="0,0,0,6"/>

                <TextBlock Text="Выгрузка в Excel. Набор файлов зависит от вашей роли. Экранная аналитика будет добавлена после интеграции данных."

                           FontSize="14"

                           Foreground="{DynamicResource ThemeTextMutedBrush}"

                           Margin="0,0,0,24"/>



                <StackPanel>

                    <Button x:Name="OperationalReportButton"

                            Style="{StaticResource ReportCardButtonStyle}"

                            Margin="0,0,0,16"

                            MinHeight="160"

                            Click="OperationalReportButton_Click">

                        <StackPanel HorizontalAlignment="Left">

                            <Border Width="56" Height="56" CornerRadius="18"

                                    Background="{DynamicResource ThemeSuccessBgBrush}"

                                    Margin="0,0,0,16">

                                <TextBlock Text="📋" FontSize="28"

                                           HorizontalAlignment="Center"

                                           VerticalAlignment="Center"/>

                            </Border>

                            <TextBlock Text="Операционный отчёт"

                                       FontSize="24"

                                       FontWeight="ExtraBold"

                                       Foreground="{DynamicResource ThemeTextBrush}"/>

                            <TextBlock Text="Планы KPI (с колонкой «ожидалось»), интенсивность, ведомость продаж, пробные, ученики года, пришедшие, дебиторка, ушедшие"

                                       FontSize="13"

                                       Foreground="{DynamicResource ThemeTextMutedBrush}"

                                       TextWrapping="Wrap"

                                       Margin="0,8,0,0"/>

                            <TextBlock Text="8 листов в одном файле"

                                       FontSize="12"

                                       Foreground="{DynamicResource ThemeTextSubtleBrush}"

                                       Margin="0,6,0,0"/>

                        </StackPanel>

                    </Button>



                    <Button x:Name="FinanceReportButton"

                            Style="{StaticResource ReportCardButtonStyle}"

                            Margin="0,0,0,16"

                            MinHeight="160"

                            Click="FinanceReportButton_Click">

                        <StackPanel HorizontalAlignment="Left">

                            <Border Width="56" Height="56" CornerRadius="18"

                                    Background="{DynamicResource ThemeInfoBgBrush}"

                                    Margin="0,0,0,16">

                                <TextBlock Text="💰" FontSize="28"

                                           HorizontalAlignment="Center"

                                           VerticalAlignment="Center"/>

                            </Border>

                            <TextBlock Text="Финансы (касса)"

                                       FontSize="24"

                                       FontWeight="ExtraBold"

                                       Foreground="{DynamicResource ThemeTextBrush}"/>

                            <TextBlock Text="Ежедневный приход по каналам оплаты и реестр расходов"

                                       FontSize="13"

                                       Foreground="{DynamicResource ThemeTextMutedBrush}"

                                       TextWrapping="Wrap"

                                       Margin="0,8,0,0"/>

                            <TextBlock Text="Листы «ДУ» и «расходы»"

                                       FontSize="12"

                                       Foreground="{DynamicResource ThemeTextSubtleBrush}"

                                       Margin="0,6,0,0"/>

                        </StackPanel>

                    </Button>



                    <Button x:Name="YearReportButton"

                            Style="{StaticResource ReportCardButtonStyle}"

                            Margin="0,0,0,16"

                            MinHeight="160"

                            Click="YearReportButton_Click">

                        <StackPanel HorizontalAlignment="Left">

                            <Border Width="56" Height="56" CornerRadius="18"

                                    Background="{DynamicResource ThemePrimaryBrush}"

                                    Margin="0,0,0,16">

                                <TextBlock Text="📑" FontSize="28"

                                           HorizontalAlignment="Center"

                                           VerticalAlignment="Center"

                                           Foreground="{DynamicResource ThemeOnPrimaryBrush}"/>

                            </Border>

                            <TextBlock Text="Учебный год"

                                       FontSize="24"

                                       FontWeight="ExtraBold"

                                       Foreground="{DynamicResource ThemeTextBrush}"/>

                            <TextBlock Text="Свод по направлениям (авг—май), источники прихода, состав групп по направлениям, лагерь по источникам"

                                       FontSize="13"

                                       Foreground="{DynamicResource ThemeTextMutedBrush}"

                                       TextWrapping="Wrap"

                                       Margin="0,8,0,0"/>

                            <TextBlock Text="Несколько листов в одном файле"

                                       FontSize="12"

                                       Foreground="{DynamicResource ThemeTextSubtleBrush}"

                                       Margin="0,6,0,0"/>

                        </StackPanel>

                    </Button>

                    <Button x:Name="GeographyReportButton"

                            Style="{StaticResource ReportCardButtonStyle}"

                            Margin="0,0,0,0"

                            MinHeight="160"

                            Click="GeographyReportButton_Click">
                        <StackPanel HorizontalAlignment="Left">
                            <Border Width="56" Height="56" CornerRadius="18"
                                    Background="{DynamicResource ThemeInfoBgBrush}"
                                    Margin="0,0,0,16">
                                <TextBlock Text="🗺" FontSize="28"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="География: школы и детсады"
                                       FontSize="24" FontWeight="ExtraBold"
                                       Foreground="{DynamicResource ThemeTextBrush}"/>
                            <TextBlock Text="Статистика по учебным заведениям — откуда приходят дети"
                                       FontSize="13" Foreground="{DynamicResource ThemeTextMutedBrush}"
                                       TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Button>

                </StackPanel>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</Window>

