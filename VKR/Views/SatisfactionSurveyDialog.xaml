<Window x:Class="VKR.Views.SatisfactionSurveyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Опрос обучающегося"
        Width="640" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="InputLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSubtleBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource ThemeSurfaceBrush}" CornerRadius="20" Margin="12"
            BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1">
        <StackPanel Margin="32">
            <TextBlock x:Name="TitleText" Text="Опрос" FontSize="22" FontWeight="ExtraBold"
                       Foreground="{DynamicResource ThemeTextBrush}" Margin="0,0,0,4"/>
            <TextBlock x:Name="SubtitleText" FontSize="13" Foreground="{DynamicResource ThemeTextMutedBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,20"/>

            <TextBlock Text="КАК РЕБЁНКУ ЗАНИМАТЬСЯ?" Style="{StaticResource InputLabelStyle}"/>
            <ComboBox x:Name="LevelComboBox" Height="42" FontSize="13" Margin="0,0,0,16"
                      DisplayMemberPath="Name" SelectionChanged="LevelComboBox_SelectionChanged"/>

            <StackPanel x:Name="NegativePanel" Visibility="Collapsed" Margin="0,0,0,16">
                <TextBlock Text="ПРИЧИНА (ЕСЛИ НЕ НРАВИТСЯ)" Style="{StaticResource InputLabelStyle}"/>
                <ComboBox x:Name="ReasonComboBox" Height="42" FontSize="13" Margin="0,0,0,14"
                          DisplayMemberPath="Name"/>

                <TextBlock Text="ПРЕДЛОЖИТЬ НАПРАВЛЕНИЕ ИЗ ЗАЯВКИ" Style="{StaticResource InputLabelStyle}"/>
                <ComboBox x:Name="AlternateDirectionComboBox" Height="42" FontSize="13"
                          DisplayMemberPath="Name"/>
                <TextBlock Text="Показываются направления, которые ребёнок выбирал в заявке, кроме текущего"
                           FontSize="10" FontStyle="Italic" Foreground="{DynamicResource ThemeTextSubtleBrush}"
                           Margin="2,6,0,0"/>
            </StackPanel>

            <TextBlock Text="КОММЕНТАРИЙ" Style="{StaticResource InputLabelStyle}"/>
            <Border Background="{DynamicResource ThemeSurfaceBrush}" CornerRadius="12"
                    BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Margin="0,0,0,16">
                <TextBox x:Name="CommentTextBox" Height="72" Padding="14,10" BorderThickness="0"
                         FontSize="13" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" Background="Transparent"/>
            </Border>

            <Border x:Name="ErrorBorder" Background="{DynamicResource ThemeDangerBgBrush}" CornerRadius="12"
                    Padding="14,10" Margin="0,0,0,12" Visibility="Collapsed">
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ThemeDangerFgBrush}"
                           FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" Width="120" Style="{StaticResource DialogButtonStyle}"
                        Background="{DynamicResource ThemeSurfaceBrush}" Foreground="{DynamicResource ThemeTextBrush}"
                        BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                        Margin="0,0,8,0" Click="CancelButton_Click"/>
                <Button Content="Сохранить" Width="140" Style="{StaticResource DialogButtonStyle}"
                        Background="{DynamicResource ThemePrimaryBrush}" Foreground="{DynamicResource ThemeOnPrimaryBrush}"
                        Click="SaveButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
