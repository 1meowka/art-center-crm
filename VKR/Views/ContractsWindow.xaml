<Window x:Class="VKR.Views.ContractsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Договоры — Арт-студия"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource ThemeBgBrush}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- ===== Стиль контурной кнопки ===== -->
        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeBgBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeBorderHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Тёмная кнопка ===== -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemePrimaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeOnPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemePrimaryHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemePrimaryPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Текстовое поле ===== -->
        <Style x:Key="RoundedTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== DataGrid ===== -->
        <Style x:Key="ModernDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource ThemeGridLineBrush}"/>
            <Setter Property="RowHeight" Value="24"/>
            <Setter Property="ColumnHeaderHeight" Value="24"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="RowBackground" Value="{DynamicResource ThemeSurfaceBrush}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource ThemeSurfaceBrush}"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
        </Style>

        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource ThemeHoverSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextMutedBrush}"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeBgBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E0E7FF"/>
                    <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" Margin="2,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============== ШАПКА ============== -->
        <Border Grid.Row="0" Background="{DynamicResource ThemeHeaderBrush}"
                BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="28,16,28,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Resources/logo.png" Width="44" Height="44" Margin="0,0,14,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ТЕКУЩИЙ РАЗДЕЛ" FontSize="11"
                                   FontWeight="Black" Foreground="{DynamicResource ThemeTextSubtleBrush}"/>
                        <TextBlock Text="Договоры" FontSize="22"
                                   FontWeight="ExtraBold" Foreground="{DynamicResource ThemeTextBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Button Content="← Назад" Style="{StaticResource HeaderButtonStyle}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="BackButton_Click"/>
            </Grid>
        </Border>

        <!-- ============== КОНТЕНТ ============== -->
        <Grid Grid.Row="1" Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="240"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

                <!-- Заголовок и действия -->
                <Grid Margin="0,0,0,24">
                    <StackPanel HorizontalAlignment="Left">
                        <TextBlock Text="Управление договорами" FontSize="32"
                                   FontWeight="ExtraBold" Foreground="{DynamicResource ThemeTextBrush}"/>
                        <TextBlock Text="Договор заключается на обучающегося. У ребёнка родитель выбирается из его карточки"
                                   FontSize="14" Foreground="{DynamicResource ThemeTextMutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="🔄  Обновить" Style="{StaticResource HeaderButtonStyle}"
                                Click="Refresh_Click"/>
                        <Button Content="➕  Добавить договор" Style="{StaticResource PrimaryButtonStyle}"
                                Click="AddContract_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Фильтры -->
                <Border Grid.Row="1" Background="{DynamicResource ThemeSurfaceBrush}" CornerRadius="20" Padding="20"
                        BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="ПОИСК" FontSize="11" FontWeight="Black"
                                       Foreground="{DynamicResource ThemeTextSubtleBrush}" Margin="0,0,0,6"/>
                            <TextBox x:Name="SearchBox" Style="{StaticResource RoundedTextBoxStyle}"
                                     TextChanged="SearchBox_TextChanged"
                                     ToolTip="Дата (дд.мм.гггг), ФИО обучающегося или заказчика, номер договора"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="СТАТУС" FontSize="11" FontWeight="Black"
                                       Foreground="{DynamicResource ThemeTextSubtleBrush}" Margin="0,0,0,6"/>
                            <ComboBox x:Name="StatusCombo"
                                      Style="{StaticResource RoundedComboBoxStyle}"
                                      SelectionChanged="StatusCombo_SelectionChanged"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="все"/>
                                <ComboBoxItem Content="активен"/>
                                <ComboBoxItem Content="завершен"/>
                                <ComboBoxItem Content="расторгнут"/>
                                <ComboBoxItem Content="архивный"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="С ДАТЫ" FontSize="11" FontWeight="Black"
                                       Foreground="{DynamicResource ThemeTextSubtleBrush}" Margin="0,0,0,6"/>
                            <DatePicker x:Name="DateFromPicker"
                                        SelectedDateChanged="DateFilter_Changed"/>
                        </StackPanel>

                        <StackPanel Grid.Column="6">
                            <TextBlock Text="ПО ДАТУ" FontSize="11" FontWeight="Black"
                                       Foreground="{DynamicResource ThemeTextSubtleBrush}" Margin="0,0,0,6"/>
                            <DatePicker x:Name="DateToPicker"
                                        SelectedDateChanged="DateFilter_Changed"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Список договоров -->
                <Border Grid.Row="2" Background="{DynamicResource ThemeSurfaceBrush}" CornerRadius="20"
                        BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Padding="0">
                    <Border.Effect>
                        <DropShadowEffect Color="{DynamicResource ThemeShadowColor}" BlurRadius="32"
                                          ShadowDepth="12" Opacity="0.05"/>
                    </Border.Effect>
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Padding="20,14"
                                BorderBrush="{DynamicResource ThemeGridLineBrush}" BorderThickness="0,0,0,1">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Список договоров" FontSize="15"
                                           FontWeight="ExtraBold" Foreground="{DynamicResource ThemeTextBrush}"/>
                                <TextBlock x:Name="CountText"
                                           Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="11"
                                           FontWeight="SemiBold" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <DataGrid x:Name="ContractsGrid"
                                  Style="{StaticResource ModernDataGridStyle}"
                                  EnableColumnVirtualization="False"
                                  CanUserResizeColumns="True"
                                  CanUserReorderColumns="True"
                                  SelectionChanged="ContractsGrid_SelectionChanged"
                                  MouseDoubleClick="ContractsGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="№" Binding="{Binding ContractNumber}" Width="70" MinWidth="60">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="ЗАКАЗЧИК" Binding="{Binding RepresentativeFullNameText}" Width="1.4*" MinWidth="140"
                                                    ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="ОБУЧАЮЩИЙСЯ" Binding="{Binding StudentFullNameText}" Width="1.4*" MinWidth="140"
                                                    ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="ФИЛИАЛ" Binding="{Binding BranchNameText}" Width="100" MinWidth="80"
                                                    ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="НАПРАВЛЕНИЕ" Binding="{Binding DirectionName}" Width="120" MinWidth="90"
                                                    ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="ЗАКЛЮЧЁН" Binding="{Binding ContractDateText}" Width="92" MinWidth="86"
                                                    ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="НАЧАЛО" Binding="{Binding StartDateText}" Width="86" MinWidth="80"
                                                    ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="ОКОНЧАНИЕ" Binding="{Binding EndDateText}" Width="92" MinWidth="86"
                                                    ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="СУММА" Binding="{Binding TotalAmountText}" Width="100" MinWidth="88"
                                                    ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="ОПЛАЧЕНО" Binding="{Binding PaidAmountText}" Width="100" MinWidth="88"
                                                    ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="ОСТАТОК" Binding="{Binding OutstandingText}" Width="100" MinWidth="88"
                                                    ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="СТАТУС" Binding="{Binding Status}" Width="100" MinWidth="80"
                                                    ElementStyle="{StaticResource CellText}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <!-- Карточка выбранного договора + действия -->
                <Border Grid.Row="3" Background="{DynamicResource ThemeSurfaceBrush}" CornerRadius="20" Padding="20"
                        BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Margin="0,16,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="48" Height="48"
                                Background="#FFA94D"
                                CornerRadius="16"
                                Margin="0,0,14,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="📄" FontSize="22"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="SelectedContractTitle"
                                       Text="Договор не выбран"
                                       FontWeight="ExtraBold"
                                       FontSize="16"
                                       Foreground="{DynamicResource ThemeTextBrush}"/>
                            <TextBlock x:Name="SelectedContractInfo"
                                       Text="Выберите строку, чтобы увидеть детали и действия."
                                       Foreground="{DynamicResource ThemeTextMutedBrush}"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="✏  Редактировать"
                                    Click="EditContract_Click"
                                    Style="{StaticResource HeaderButtonStyle}"/>
                            <Button Content="📦  В архив"
                                    Click="ArchiveContract_Click"
                                    Style="{StaticResource HeaderButtonStyle}"/>
                            <Button x:Name="DeleteContractButton" Content="🗑  Удалить"
                                    Click="DeleteContract_Click"
                                    Style="{StaticResource HeaderButtonStyle}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Сообщение об ошибке -->
                <Border Grid.Row="4" x:Name="ErrorBorder" Background="#FF6B6B" CornerRadius="12"
                        Padding="14,10" Margin="0,16,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ThemeDangerFgBrush}"
                               FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </Border>
        </Grid>
    </Grid>
</Window>
