<Window x:Class="VKR.Views.AiAnalyticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ИИ-аналитика — Арт-студия"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource ThemeBgBrush}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="HeaderButtonStyle" TargetType="Button" BasedOn="{StaticResource SectionHeaderButtonStyle}"/>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SectionPrimaryButtonStyle}"/>

        <Style x:Key="TabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextMutedBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="22,12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeBgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TabButtonActiveStyle" TargetType="Button" BasedOn="{StaticResource TabButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource ThemePrimaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeOnPrimaryBrush}"/>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="MutedTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextMutedBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="KpiValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
        </Style>
        <Style x:Key="ModernDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="RowHeight" Value="24"/>
            <Setter Property="ColumnHeaderHeight" Value="24"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="MinHeight" Value="360"/>
        </Style>
        <Style x:Key="RecommendationCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource ThemeHeaderBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="28,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="ИИ-АНАЛИТИКА" FontSize="11" FontWeight="Black" Foreground="{DynamicResource ThemeTextSubtleBrush}"/>
                    <TextBlock Text="Прогнозы оттока и конверсии" FontSize="22" FontWeight="ExtraBold" Foreground="{DynamicResource ThemeTextBrush}" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="↻ Пересчитать прогнозы" Style="{StaticResource PrimaryButtonStyle}" Click="RecalculateButton_Click"/>
                    <Button Content="✕ Закрыть" Style="{StaticResource HeaderButtonStyle}" Margin="8,0,0,0" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="28,16,28,0">
            <Button x:Name="TabSummaryButton" Content="Сводка" Style="{StaticResource TabButtonActiveStyle}" Click="TabSummary_Click"/>
            <Button x:Name="TabChurnButton" Content="Отток" Style="{StaticResource TabButtonStyle}" Click="TabChurn_Click"/>
            <Button x:Name="TabConversionButton" Content="Приток / гости" Style="{StaticResource TabButtonStyle}" Click="TabConversion_Click"/>
            <Button x:Name="TabRecommendationsButton" Content="Рекомендации" Style="{StaticResource TabButtonStyle}" Click="TabRecommendations_Click"/>
            <Button x:Name="TabFormulaButton" Content="Формулы" Style="{StaticResource TabButtonStyle}" Click="TabFormula_Click"/>
        </StackPanel>

        <Border x:Name="ErrorMessageText" Grid.Row="2" Margin="28,12,28,0" Background="#FEE2E2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="12" Padding="12" Visibility="Collapsed">
            <TextBlock x:Name="ErrorText" Foreground="#991B1B" TextWrapping="Wrap"/>
        </Border>

        <ScrollViewer Grid.Row="3" Margin="28,16,28,24" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <StackPanel x:Name="SummaryPanel">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Последний пересчёт:" Style="{StaticResource MutedTextStyle}"/>
                        <TextBlock x:Name="LastCalcDateText" Grid.Column="1" HorizontalAlignment="Right" FontWeight="Bold"/>
                    </Grid>
                    <TextBlock x:Name="RecommendationsCountText" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,14"/>

                    <UniformGrid Columns="3" Margin="0,0,0,8">
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,8,14">
                            <StackPanel>
                                <TextBlock Text="Обучающиеся" Style="{StaticResource MutedTextStyle}"/>
                                <TextBlock x:Name="ActiveStudentsText" Style="{StaticResource KpiValueStyle}"/>
                                <TextBlock x:Name="ArchivedStudentsText" Style="{StaticResource MutedTextStyle}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Margin="4,0">
                            <StackPanel>
                                <TextBlock Text="Движение за месяц" Style="{StaticResource MutedTextStyle}"/>
                                <TextBlock x:Name="NewStudentsText" Style="{StaticResource KpiValueStyle}"/>
                                <TextBlock x:Name="LeftStudentsText" Style="{StaticResource MutedTextStyle}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Margin="8,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Отток / прирост" Style="{StaticResource MutedTextStyle}"/>
                                <TextBlock x:Name="ChurnRateText" Style="{StaticResource KpiValueStyle}"/>
                                <TextBlock x:Name="GrowthRateText" Style="{StaticResource MutedTextStyle}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <UniformGrid Columns="3">
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,8,14">
                            <StackPanel>
                                <TextBlock Text="Посещаемость (30 дн.)" Style="{StaticResource MutedTextStyle}"/>
                                <TextBlock x:Name="AttendanceRateText" Style="{StaticResource KpiValueStyle}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Margin="4,0">
                            <StackPanel>
                                <TextBlock Text="Риск оттока" Style="{StaticResource MutedTextStyle}"/>
                                <TextBlock x:Name="HighRiskText" Style="{StaticResource KpiValueStyle}"/>
                                <TextBlock x:Name="MediumRiskText" Style="{StaticResource MutedTextStyle}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Margin="8,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Карточки гостей / конверсия" Style="{StaticResource MutedTextStyle}"/>
                                <TextBlock x:Name="ActiveLeadsText" Style="{StaticResource KpiValueStyle}"/>
                                <TextBlock x:Name="HighConversionText" Style="{StaticResource MutedTextStyle}"/>
                                <TextBlock x:Name="ExpectedClientsText" Style="{StaticResource MutedTextStyle}"/>
                                <TextBlock x:Name="ConversionLevelsText" Style="{StaticResource MutedTextStyle}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Задолженность" FontWeight="Bold" FontSize="16"/>
                            <TextBlock x:Name="TotalDebtText" Style="{StaticResource KpiValueStyle}" Margin="0,8,0,0"/>
                            <TextBlock x:Name="DebtorsText" Style="{StaticResource MutedTextStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Направления" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                            <DataGrid x:Name="DirectionGrid" Style="{StaticResource ModernDataGridStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Направление" Binding="{Binding DirectionName}" Width="*"/>
                                    <DataGridTextColumn Header="Активные" Binding="{Binding ActiveStudentsCount}" Width="90"/>
                                    <DataGridTextColumn Header="Высокий риск" Binding="{Binding HighRiskCount}" Width="110"/>
                                    <DataGridTextColumn Header="Ср. отток" Binding="{Binding AverageChurnProbabilityText}" Width="100"/>
                                    <DataGridTextColumn Header="Гости" Binding="{Binding ActiveLeadsCount}" Width="80"/>
                                    <DataGridTextColumn Header="Ср. конверсия" Binding="{Binding AverageConversionProbabilityText}" Width="120"/>
                                    <DataGridTextColumn Header="Долг" Binding="{Binding TotalDebt, StringFormat=N0}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="ChurnPanel" Visibility="Collapsed">
                    <TextBlock Text="Риск считается по посещаемости, задолженности, просрочке, окончанию договора, событиям активности и давности последнего контакта."
                               Style="{StaticResource MutedTextStyle}" Margin="0,0,0,14"/>
                    <DataGrid x:Name="ChurnGrid" Style="{StaticResource ModernDataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Обучающийся" Binding="{Binding StudentFullName}" Width="*"/>
                            <DataGridTextColumn Header="Телефон" Binding="{Binding StudentPhone}" Width="130"/>
                            <DataGridTextColumn Header="P оттока" Binding="{Binding ChurnProbabilityText}" Width="90"/>
                            <DataGridTextColumn Header="Уровень" Binding="{Binding RiskLevel}" Width="90"/>
                            <DataGridTextColumn Header="Факторы" Binding="{Binding ChurnFactors}" Width="2*"/>
                            <DataGridTextColumn Header="Рекомендация" Binding="{Binding RecommendedAction}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>

                <StackPanel x:Name="ConversionPanel" Visibility="Collapsed">
                    <TextBlock Text="Прогноз конверсии открытых заявок по воронке продаж."
                               Style="{StaticResource MutedTextStyle}" Margin="0,0,0,14"/>
                    <DataGrid x:Name="ConversionGrid" Style="{StaticResource ModernDataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Карточка гостя" Binding="{Binding LeadFullName}" Width="*"/>
                            <DataGridTextColumn Header="Телефон" Binding="{Binding LeadPhone}" Width="130"/>
                            <DataGridTextColumn Header="P конверсии" Binding="{Binding ConversionProbabilityText}" Width="100"/>
                            <DataGridTextColumn Header="Уровень" Binding="{Binding ProbabilityLevel}" Width="90"/>
                            <DataGridTextColumn Header="Факторы" Binding="{Binding ConversionFactors}" Width="2*"/>
                            <DataGridTextColumn Header="Рекомендация" Binding="{Binding RecommendedAction}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>

                <StackPanel x:Name="RecommendationsPanel" Visibility="Collapsed">
                    <TextBlock Text="Список собирается из последних прогнозов. Отметка «выполнено» переносит задачу в журнал действий администратора. Двойной щелчок — карточка клиента."
                               Style="{StaticResource MutedTextStyle}" Margin="0,0,0,14"/>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Очередь задач" FontSize="18" FontWeight="ExtraBold" Foreground="#0F172A" Margin="0,0,0,10"/>
                            <ListBox x:Name="RecommendationsListBox" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Height="420">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" Style="{StaticResource RecommendationCheckBoxStyle}" Margin="0,3,14,0"
                                                          ToolTip="Отметить как выполненную"
                                                          IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                                          Checked="RecommendationCheckBox_Changed"
                                                          Unchecked="RecommendationCheckBox_Changed"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0"/>
                                                    <TextBlock FontSize="12" Foreground="#475569" TextWrapping="Wrap" Margin="0,8,0,0">
                                                        <Run Text="Признаки: "/>
                                                        <Run Text="{Binding TriggeredSigns, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <Border Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1" CornerRadius="10" Padding="10,5" HorizontalAlignment="Left" Margin="0,8,0,0">
                                                        <TextBlock FontSize="11" FontWeight="Bold" Foreground="#4338CA">
                                                            <Run Text="Правило "/>
                                                            <Run Text="{Binding RuleCode, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock x:Name="RecommendationHistoryEmptyText"
                                       Text="Выполненные рекомендации появятся здесь после отметки «выполнено»."
                                       Style="{StaticResource MutedTextStyle}" Margin="0,20,0,0" Visibility="Collapsed"/>

                            <StackPanel x:Name="RecommendationHistoryPanel" Margin="0,20,0,0" Visibility="Collapsed">
                                <TextBlock Text="Журнал выполненных рекомендаций" FontSize="18" FontWeight="ExtraBold" Foreground="#0F172A" Margin="0,0,0,10"/>
                                <TextBlock Text="История сохраняется в БД: кто, когда и по какому правилу выполнил действие."
                                           Style="{StaticResource MutedTextStyle}" Margin="0,0,0,10"/>
                                <ListBox x:Name="RecommendationHistoryListBox" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0,0,0,10"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="14" Padding="14">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding RecommendationText}" FontWeight="Bold" TextWrapping="Wrap"/>
                                                    <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="#475569" TextWrapping="Wrap">
                                                        <Run Text="{Binding EntityDisplayName, Mode=OneWay}"/>
                                                        <Run Text=" · "/>
                                                        <Run Text="{Binding RecommendationType, Mode=OneWay}"/>
                                                        <Run Text=" · правило "/>
                                                        <Run Text="{Binding RuleCodeText, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="#64748B" TextWrapping="Wrap">
                                                        <Run Text="Выполнено: "/>
                                                        <Run Text="{Binding CompletedAtText, Mode=OneWay}"/>
                                                        <Run Text=" · "/>
                                                        <Run Text="{Binding CompletedByName, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="FormulaPanel" Visibility="Collapsed">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Прогноз оттока" FontSize="18" FontWeight="ExtraBold"/>
                            <TextBlock TextWrapping="Wrap" Margin="0,10,0,0">
                                <Run Text="Pотт = 0,25·x1 + 0,18·x2 + 0,18·x3 + 0,12·x4 + 0,12·x5 + 0,15·x6"/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,10,0,0" Text="x1 = 1 - Kпосещаемости (если нет записей за 30 дней — x1 = 0,5)"/>
                            <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,6,0,0" Text="x2 = Kзадолженности = D / Sдоговора"/>
                            <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,6,0,0" Text="x3 = min(дней просрочки / 30, 1)"/>
                            <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,6,0,0" Text="x4 = близость окончания договора за 14 дней"/>
                            <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,6,0,0" Text="x5 = наличие событий приостановки, ухода или снижения активности"/>
                            <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,6,0,0" Text="x6 = давность контакта / пребывания в центре"/>
                            <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,10,0,0" Text="Пороги: низкий &lt; 0,35; средний 0,35–0,70; высокий ≥ 0,70"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Прогноз конверсии карточки гостя" FontSize="18" FontWeight="ExtraBold"/>
                            <TextBlock TextWrapping="Wrap" Margin="0,10,0,0">
                                <Run Text="Pконв = 0,20·y1 + 0,15·y2 + 0,30·y3 + 0,20·y4 + 0,15·y5"/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,10,0,0" Text="y1 — конверсия источника; y2 — направления; y3 — пробное занятие; y4 — скорость обработки; y5 — результат контакта"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
