<Window x:Class="VKR.Views.MaxBotPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ввод"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource ThemeBgBrush}"
        FontFamily="Segoe UI">

    <Border Margin="24" Background="{DynamicResource ThemeSurfaceBrush}"
            CornerRadius="20" Padding="24"
            BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1">
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="18" FontWeight="ExtraBold"
                       Foreground="{DynamicResource ThemeTextBrush}"/>
            <TextBlock x:Name="LabelText" Margin="0,8,0,8"
                       Foreground="{DynamicResource ThemeTextMutedBrush}"/>
            <TextBox x:Name="InputBox" Height="40" Padding="12,0" VerticalContentAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Отмена" Padding="14,8" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button Content="OK" Padding="14,8" FontWeight="Bold" Click="Ok_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
