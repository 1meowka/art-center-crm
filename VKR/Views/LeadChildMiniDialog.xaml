<Window x:Class="VKR.Views.LeadChildMiniDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Title="Ребёнок"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent" AllowsTransparency="True"
        FontFamily="Segoe UI">
    <Border Background="{DynamicResource ThemeSurfaceBrush}" CornerRadius="16" Margin="10"
            BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Padding="24">
        <StackPanel>
            <TextBlock Text="Данные ребёнка" FontSize="18" FontWeight="ExtraBold" Margin="0,0,0,14"/>
            <TextBlock Text="ФИО *" FontSize="11" FontWeight="Black" Foreground="{DynamicResource ThemeTextSubtleBrush}" Margin="0,0,0,4"/>
            <TextBox x:Name="FullNameBox" Height="36" Padding="10,0" VerticalContentAlignment="Center" Margin="0,0,0,10"/>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="ДАТА РОЖДЕНИЯ" FontSize="11" FontWeight="Black" Foreground="{DynamicResource ThemeTextSubtleBrush}" Margin="0,0,0,4"/>
                    <xctk:MaskedTextBox x:Name="BirthDateBox" Mask="00\.00\.0000" Height="36"
                                        Padding="10,0" VerticalContentAlignment="Center" PromptChar="_"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2">
                    <TextBlock Text="ТЕЛЕФОН" FontSize="11" FontWeight="Black" Foreground="{DynamicResource ThemeTextSubtleBrush}" Margin="0,0,0,4"/>
                    <xctk:MaskedTextBox x:Name="PhoneBox" Mask="+7 (000) 000-00-00" Height="36"
                                        Padding="10,0" VerticalContentAlignment="Center" PromptChar="_"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,10,0,0">
                    <TextBlock Text="АДРЕС ПРОЖИВАНИЯ" FontSize="11" FontWeight="Black" Foreground="{DynamicResource ThemeTextSubtleBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="ResidenceAddressBox" MinHeight="52" MaxHeight="52" Padding="10,8"
                             TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Disabled"/>
                </StackPanel>
            </Grid>
            <TextBlock x:Name="ErrorText" Foreground="#E11D48" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,4,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Отмена" Width="100" Height="36" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button Content="Сохранить" Width="110" Height="36" Click="Save_Click"
                        Background="{DynamicResource ThemePrimaryBrush}" Foreground="{DynamicResource ThemeOnPrimaryBrush}" BorderThickness="0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
