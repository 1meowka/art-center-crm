<Window x:Class="VKR.Views.ConvertLeadDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Title="Зачисление в обучающиеся"
        Width="920" MaxHeight="900"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="InputBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="42"/>
        </Style>

        <Style x:Key="PrefilledBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#F0FDF4"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#86EFAC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="42"/>
        </Style>

        <Style x:Key="InputLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSubtleBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource ThemeSurfaceBrush}" CornerRadius="20" Margin="12"
            BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="{DynamicResource ThemeShadowColor}" BlurRadius="40" 
                              ShadowDepth="12" Opacity="0.25"/>
        </Border.Effect>
        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="860">
        <StackPanel Margin="32">

            <!-- Заголовок -->
            <Grid Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="🎓  ЗАЧИСЛЕНИЕ" FontSize="11" 
                               FontWeight="Black" Foreground="{DynamicResource ThemeTextSubtleBrush}"/>
                    <TextBlock Text="Перевод карточки гостя в обучающиеся" 
                               FontSize="22" FontWeight="ExtraBold" 
                               Foreground="{DynamicResource ThemeTextBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Width="32" Height="32" Background="{DynamicResource ThemeBgBrush}" 
                        Foreground="{DynamicResource ThemeTextMutedBrush}" BorderThickness="0" Cursor="Hand"
                        Click="CancelButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="14">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Подсказка про предзаполненные поля -->
            <Border Background="#F0FDF4" CornerRadius="12" Padding="14,10" Margin="0,0,0,20"
                    BorderBrush="#86EFAC" BorderThickness="1">
                <TextBlock FontSize="12" Foreground="{DynamicResource ThemeSuccessFgBrush}" TextWrapping="Wrap">
                    <Run Text="✓" FontWeight="Black"/>
                    <Run Text=" Поля с зелёной рамкой заполнены из карточки гостя автоматически. Дополните недостающие данные."/>
                </TextBlock>
            </Border>

            <Border Background="{DynamicResource ThemeInfoBgBrush}" CornerRadius="12" Padding="14,10" Margin="0,0,0,16">
                <TextBlock x:Name="ClientPayerText" TextWrapping="Wrap" FontSize="13"
                           Foreground="{DynamicResource ThemeInfoFgBrush}"/>
            </Border>

            <Border Background="{DynamicResource ThemeHoverSurfaceBrush}" CornerRadius="16" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="КТО БУДЕТ ХОДИТЬ НА ЗАНЯТИЯ" Style="{StaticResource InputLabelStyle}"/>
                    <TextBlock Text="Договор заключается на выбранного человека. Если это ребёнок, родителя администратор выберет из его карточки при оформлении договора."
                               FontSize="12" Foreground="{DynamicResource ThemeTextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <TextBox x:Name="CandidateSearchBox" Height="36" Padding="10,0" Margin="0,0,0,8"
                             VerticalContentAlignment="Center" FontSize="13"
                             ToolTip="Поиск по ФИО, роли или телефону"
                             TextChanged="CandidateSearchBox_TextChanged"/>
                    <DataGrid x:Name="CandidatesGrid" Height="150" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="None"
                              FontSize="12" SelectionChanged="CandidatesGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="РОЛЬ" Binding="{Binding RoleLabel}" Width="140"/>
                            <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*"/>
                            <DataGridTextColumn Header="ТЕЛЕФОН" Binding="{Binding Phone}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Фамилия (предзаполнено если было) -->
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,14">
                    <TextBlock Style="{StaticResource InputLabelStyle}">
                        <Run Text="ФАМИЛИЯ"/>
                    </TextBlock>
                    <Border x:Name="LastNameBorder" Style="{StaticResource InputBorderStyle}">
                        <TextBox x:Name="LastNameTextBox" Padding="14,0" 
                                 BorderThickness="0" VerticalContentAlignment="Center" 
                                 FontSize="13" Background="Transparent"/>
                    </Border>
                </StackPanel>

                <!-- Имя (предзаполнено) -->
                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,14">
                    <TextBlock Style="{StaticResource InputLabelStyle}">
                        <Run Text="ИМЯ"/>
                    </TextBlock>
                    <Border x:Name="FirstNameBorder" Style="{StaticResource PrefilledBorderStyle}">
                        <TextBox x:Name="FirstNameTextBox" Padding="14,0" 
                                 BorderThickness="0" VerticalContentAlignment="Center" 
                                 FontSize="13" Background="Transparent"/>
                    </Border>
                </StackPanel>

                <!-- Отчество -->
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,14">
                    <TextBlock Text="ОТЧЕСТВО" Style="{StaticResource InputLabelStyle}"/>
                    <Border Style="{StaticResource InputBorderStyle}">
                        <TextBox x:Name="MiddleNameTextBox" Padding="14,0" 
                                 BorderThickness="0" VerticalContentAlignment="Center" 
                                 FontSize="13" Background="Transparent"/>
                    </Border>
                </StackPanel>

                <!-- Дата рождения (предзаполнено) -->
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,14">
                    <TextBlock Style="{StaticResource InputLabelStyle}">
                        <Run Text="ДАТА РОЖДЕНИЯ"/>
                    </TextBlock>
                    <Border x:Name="BirthDateBorder" Style="{StaticResource PrefilledBorderStyle}">
                        <xctk:MaskedTextBox x:Name="BirthDateMaskedBox"
                                            Mask="00\.00\.0000"
                                            BorderThickness="0" Background="Transparent"
                                            VerticalContentAlignment="Center" Padding="14,0"
                                            FontSize="13" PromptChar="_"/>
                    </Border>
                </StackPanel>

                <!-- Телефон (предзаполнено) -->
                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,14">
                    <TextBlock Text="ТЕЛЕФОН ОБУЧАЮЩЕГОСЯ" Style="{StaticResource InputLabelStyle}"/>
                    <Border x:Name="PhoneBorder" Style="{StaticResource PrefilledBorderStyle}">
                        <xctk:MaskedTextBox x:Name="PhoneMaskedBox"
                                            Mask="+7 (000) 000-00-00"
                                            BorderThickness="0" Background="Transparent"
                                            VerticalContentAlignment="Center" Padding="14,0"
                                            FontSize="13" PromptChar="_"/>
                    </Border>
                </StackPanel>

                <!-- Тип обучающегося -->
                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,14">
                    <TextBlock Style="{StaticResource InputLabelStyle}">
                        <Run Text="ТИП ОБУЧАЮЩЕГОСЯ"/>
                    </TextBlock>
                    <ComboBox x:Name="StudentTypeComboBox" Height="42" FontSize="13"
                              VerticalContentAlignment="Center"/>
                </StackPanel>

                <!-- Статус -->
                <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,14">
                    <TextBlock Text="СТАТУС" Style="{StaticResource InputLabelStyle}"/>
                    <ComboBox x:Name="StatusComboBox" Height="42" FontSize="13"
                              VerticalContentAlignment="Center">
                        <ComboBoxItem Content="активный" IsSelected="True"/>
                        <ComboBoxItem Content="приостановлен"/>
                    </ComboBox>
                </StackPanel>

                <!-- Дата прихода -->
                <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,14">
                    <TextBlock Style="{StaticResource InputLabelStyle}">
                        <Run Text="ДАТА ПРИХОДА"/>
                    </TextBlock>
                    <Border Style="{StaticResource InputBorderStyle}">
                        <xctk:MaskedTextBox x:Name="ArrivalDateMaskedBox"
                                            Mask="00\.00\.0000"
                                            BorderThickness="0" Background="Transparent"
                                            VerticalContentAlignment="Center" Padding="14,0"
                                            FontSize="13" PromptChar="_"/>
                    </Border>
                </StackPanel>

                <!-- Сообщение об ошибке -->
                <Border x:Name="ErrorBorder" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" 
                        Background="{DynamicResource ThemeDangerBgBrush}" CornerRadius="12" Padding="14,10" 
                        Margin="0,8,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ThemeDangerFgBrush}" 
                               FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </Border>

                <!-- Кнопки -->
                <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" 
                            Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Content="Отмена" Width="120" Height="42" Margin="0,0,8,0"
                            Background="{DynamicResource ThemeSurfaceBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                            Foreground="{DynamicResource ThemeTextBrush}" FontWeight="Bold" FontSize="13" Cursor="Hand"
                            Click="CancelButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="14">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeBgBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Content="🎓  Зачислить" Width="180" Height="42"
                            Background="{DynamicResource ThemePrimaryBrush}" Foreground="{DynamicResource ThemeOnPrimaryBrush}" BorderThickness="0"
                            FontWeight="Bold" FontSize="13" Cursor="Hand"
                            Click="ConvertButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="14">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemePrimaryHoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </StackPanel>
        </ScrollViewer>
    </Border>
</Window>