<Window x:Class="VKR.Views.AcademicHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="История изменений"
        Width="1000" Height="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeBgBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="История изменений" FontSize="24" FontWeight="ExtraBold" Margin="0,0,0,8"/>
        <TextBlock Grid.Row="1" Text="Смена преподавателей у групп и переводы обучающихся между группами"
                   Foreground="{DynamicResource ThemeTextMutedBrush}" Margin="0,0,0,16"/>
        <GroupBox Grid.Row="2" Header="Смена преподавателей" Margin="0,0,0,12">
            <DataGrid x:Name="TeacherHistoryGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      Style="{StaticResource ModernDataGridStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ДАТА" Binding="{Binding ChangedAtText}" Width="130"/>
                    <DataGridTextColumn Header="ГРУППА" Binding="{Binding GroupTitle}" Width="*"/>
                    <DataGridTextColumn Header="БЫЛО" Binding="{Binding TeacherOldName}" Width="160"/>
                    <DataGridTextColumn Header="СТАЛО" Binding="{Binding TeacherNewName}" Width="160"/>
                    <DataGridTextColumn Header="КТО ИЗМЕНИЛ" Binding="{Binding ChangedByName}" Width="140"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
        <GroupBox Grid.Row="3" Header="Переводы обучающихся">
            <DataGrid x:Name="TransferHistoryGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      Style="{StaticResource ModernDataGridStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ДАТА" Binding="{Binding TransferDateText}" Width="100"/>
                    <DataGridTextColumn Header="ОБУЧАЮЩИЙСЯ" Binding="{Binding StudentFullName}" Width="*"/>
                    <DataGridTextColumn Header="ИЗ ГРУППЫ" Binding="{Binding GroupFromTitle}" Width="160"/>
                    <DataGridTextColumn Header="В ГРУППУ" Binding="{Binding GroupToTitle}" Width="160"/>
                    <DataGridTextColumn Header="ПРЕПОДАВАТЕЛЬ" Binding="{Binding TeacherToName}" Width="140"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
        <Button Grid.Row="4" Content="Закрыть" HorizontalAlignment="Right" Margin="0,16,0,0"
                Width="120" Height="40" Click="Close_Click"/>
    </Grid>
</Window>
