<Window x:Class="VKR.Views.BirthdaysNotificationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Именинники — Арт-студия"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource ThemeBgBrush}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="HeaderButtonStyle" TargetType="Button" BasedOn="{StaticResource SectionHeaderButtonStyle}"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource ThemeHeaderBrush}"
                BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="28,16,28,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Resources/logo.png" Width="44" Height="44" Margin="0,0,14,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="УВЕДОМЛЕНИЯ" FontSize="11"
                                   FontWeight="Black" Foreground="{DynamicResource ThemeTextSubtleBrush}"/>
                        <TextBlock Text="Именинники" FontSize="22"
                                   FontWeight="ExtraBold" Foreground="{DynamicResource ThemeTextBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Button Content="← Назад" Style="{StaticResource HeaderButtonStyle}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="BackButton_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="28,24,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock Text="Дни рождения" FontSize="32"
                           FontWeight="ExtraBold" Foreground="{DynamicResource ThemeTextBrush}"/>
                <TextBlock Text="Кто празднует день рождения в выбранную дату — отмечайте, кого уже поздравили"
                           FontSize="14" Foreground="{DynamicResource ThemeTextMutedBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <Border Grid.Row="1" Background="{DynamicResource ThemeSurfaceBrush}" CornerRadius="20" Padding="20"
                    BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="ДАТА" FontSize="11" FontWeight="Black"
                                   Foreground="{DynamicResource ThemeTextSubtleBrush}" Margin="0,0,0,6"/>
                        <DatePicker x:Name="DatePicker"
                                    SelectedDateChanged="DatePicker_SelectedDateChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                        <Button Content="Сегодня" Style="{StaticResource HeaderButtonStyle}"
                                Click="TodayButton_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Border Background="{DynamicResource ThemeWarningBgBrush}" CornerRadius="14" Padding="14,9" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎂" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock x:Name="CountText" Text="Именинников: 0"
                                           Foreground="{DynamicResource ThemeWarningFgBrush}" FontWeight="Black"
                                           FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Button Content="🔄  Обновить" Style="{StaticResource HeaderButtonStyle}"
                                Click="Refresh_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" Background="{DynamicResource ThemeSurfaceBrush}" CornerRadius="20" ClipToBounds="True"
                    BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="20,14"
                            BorderBrush="{DynamicResource ThemeGridLineBrush}" BorderThickness="0,0,0,1">
                        <TextBlock Text="Поставьте галочку «Поздравлен», когда позвонили / поздравили лично"
                                   Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="11" FontWeight="SemiBold"/>
                    </Border>

                    <DataGrid x:Name="BirthdaysGrid"
                              Style="{StaticResource ModernDataGridStyle}"
                              PreviewMouseLeftButtonUp="BirthdaysGrid_PreviewMouseLeftButtonUp"
                              IsReadOnly="False"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="ПОЗДРАВЛЕН" Width="120" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsGreeted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Tag="{Binding}" Checked="GreetedCheck_Changed" Unchecked="GreetedCheck_Changed"
                                                  Cursor="Hand"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="2*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="ДАТА РОЖДЕНИЯ" Binding="{Binding BirthDateText}" Width="140" IsReadOnly="True"/>
                            <DataGridTextColumn Header="ВОЗРАСТ" Binding="{Binding AgeText}" Width="110" IsReadOnly="True"/>
                            <DataGridTextColumn Header="ТЕЛЕФОН" Binding="{Binding PhoneText}" Width="140" IsReadOnly="True"/>
                            <DataGridTextColumn Header="ОСНОВНОЙ ПЛАТЕЛЬЩИК" Binding="{Binding PayerText}" Width="2*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="ОТМЕТКА" Binding="{Binding GreetingDateText}" Width="120" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Row="3" x:Name="ErrorBorder" Background="{DynamicResource ThemeDangerBgBrush}" CornerRadius="12"
                    Padding="14,10" Margin="0,16,0,0" Visibility="Collapsed">
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ThemeDangerFgBrush}"
                           FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </Border>
        </Grid>
    </Grid>
</Window>
