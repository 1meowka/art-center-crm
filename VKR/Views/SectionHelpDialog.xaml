<Window x:Class="VKR.Views.SectionHelpDialog"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title=""

        Width="520" MaxHeight="640" SizeToContent="Height"

        WindowStartupLocation="CenterOwner"

        WindowStyle="None" ResizeMode="NoResize"

        Background="Transparent"

        AllowsTransparency="True"

        ShowInTaskbar="False"

        FontFamily="Segoe UI">



    <Border Background="{DynamicResource ThemeSurfaceBrush}" CornerRadius="20" Margin="12"

            BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1">

        <Border.Effect>

            <DropShadowEffect Color="{DynamicResource ThemeShadowColor}" BlurRadius="40"

                              ShadowDepth="12" Opacity="0.25"/>

        </Border.Effect>

        <StackPanel Margin="24">

            <Grid Margin="0,0,0,12">

                <TextBlock x:Name="TitleText" FontSize="22" FontWeight="ExtraBold"

                           Foreground="{DynamicResource ThemeTextBrush}"

                           VerticalAlignment="Center" Margin="0,0,40,0"/>

                <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"

                        Width="32" Height="32" Background="{DynamicResource ThemeBgBrush}"

                        Foreground="{DynamicResource ThemeTextMutedBrush}" BorderThickness="0" Cursor="Hand"

                        Click="Close_Click">

                    <Button.Template>

                        <ControlTemplate TargetType="Button">

                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="14">

                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            </Border>

                            <ControlTemplate.Triggers>

                                <Trigger Property="IsMouseOver" Value="True">

                                    <Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/>

                                </Trigger>

                            </ControlTemplate.Triggers>

                        </ControlTemplate>

                    </Button.Template>

                </Button>

            </Grid>

            <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">

                <TextBlock x:Name="BodyText" FontSize="14" LineHeight="22"

                           Foreground="{DynamicResource ThemeTextSecondaryBrush}"

                           TextWrapping="Wrap"/>

            </ScrollViewer>

            <Button Content="Понятно" HorizontalAlignment="Right" Margin="0,20,0,0"

                    Padding="20,10" FontWeight="Bold" Click="Close_Click"/>

        </StackPanel>

    </Border>

</Window>

