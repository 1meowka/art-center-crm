<Window x:Class="VKR.Views.DebtDeferDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Отсрочка оплаты"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource ThemeBgBrush}"
        FontFamily="Segoe UI">
    <Border Background="{DynamicResource ThemeSurfaceBrush}" CornerRadius="20" Margin="12"
            BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Padding="24">
        <StackPanel>
            <TextBlock Text="Отсрочка оплаты" FontSize="20" FontWeight="ExtraBold" Margin="0,0,0,4"/>
            <TextBlock x:Name="ClientHintText" FontSize="13" Foreground="{DynamicResource ThemeTextMutedBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,16"/>

            <TextBlock Text="ОТСРОЧИТЬ ДО" FontSize="11" FontWeight="Black"
                       Foreground="{DynamicResource ThemeTextSubtleBrush}" Margin="0,0,0,6"/>
            <DatePicker x:Name="DeferUntilPicker" Height="38" Margin="0,0,0,14"/>

            <TextBlock Text="КОММЕНТАРИЙ" FontSize="11" FontWeight="Black"
                       Foreground="{DynamicResource ThemeTextSubtleBrush}" Margin="0,0,0,6"/>
            <TextBox x:Name="CommentBox" MinHeight="80" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" Padding="10" FontSize="13"/>

            <Border x:Name="ErrorBorder" Background="#FF6B6B" CornerRadius="12"
                    Padding="14,10" Margin="0,14,0,0" Visibility="Collapsed">
                <TextBlock x:Name="ErrorText" Foreground="White" TextWrapping="Wrap"/>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Отмена" Padding="16,9" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button Content="Сохранить" Padding="16,9" FontWeight="Bold"
                        Background="{DynamicResource ThemePrimaryBrush}"
                        Foreground="{DynamicResource ThemeOnPrimaryBrush}"
                        BorderThickness="0" Click="Save_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
