<Window x:Class="VKR.Views.RepresentativeEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Title="Представитель"
        Width="620" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="InputBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="42"/>
        </Style>

        <Style x:Key="InputLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSubtleBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource ThemeSurfaceBrush}" CornerRadius="20" Margin="12"
            BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="{DynamicResource ThemeShadowColor}" BlurRadius="40"
                              ShadowDepth="12" Opacity="0.25"/>
        </Border.Effect>
        <StackPanel Margin="32">
            <!-- Заголовок -->
            <Grid Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock x:Name="DialogTitleText" Text="Новый представитель" FontSize="22"
                               FontWeight="ExtraBold" Foreground="{DynamicResource ThemeTextBrush}"/>
                    <TextBlock Text="Данные родителя, опекуна или плательщика"
                               FontSize="13" Foreground="{DynamicResource ThemeTextMutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Width="32" Height="32" Background="{DynamicResource ThemeBgBrush}"
                        Foreground="{DynamicResource ThemeTextMutedBrush}" BorderThickness="0" Cursor="Hand"
                        Click="Cancel_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="14">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Фамилия -->
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,14">
                    <TextBlock Style="{StaticResource InputLabelStyle}">
                        <Run Text="ФАМИЛИЯ"/>
                    </TextBlock>
                    <Border Style="{StaticResource InputBorderStyle}">
                        <TextBox x:Name="LastNameBox" Padding="14,0"
                                 BorderThickness="0" VerticalContentAlignment="Center" FontSize="13"
                                 Background="Transparent"
                                 LostFocus="NameTextBox_LostFocus"/>
                    </Border>
                </StackPanel>

                <!-- Имя -->
                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,14">
                    <TextBlock Style="{StaticResource InputLabelStyle}">
                        <Run Text="ИМЯ"/>
                    </TextBlock>
                    <Border Style="{StaticResource InputBorderStyle}">
                        <TextBox x:Name="FirstNameBox" Padding="14,0"
                                 BorderThickness="0" VerticalContentAlignment="Center" FontSize="13"
                                 Background="Transparent"
                                 LostFocus="NameTextBox_LostFocus"/>
                    </Border>
                </StackPanel>

                <!-- Отчество -->
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,14">
                    <TextBlock Text="ОТЧЕСТВО" Style="{StaticResource InputLabelStyle}"/>
                    <Border Style="{StaticResource InputBorderStyle}">
                        <TextBox x:Name="MiddleNameBox" Padding="14,0"
                                 BorderThickness="0" VerticalContentAlignment="Center" FontSize="13"
                                 Background="Transparent"
                                 LostFocus="NameTextBox_LostFocus"/>
                    </Border>
                </StackPanel>

                <!-- Телефон с маской -->
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,14">
                    <TextBlock Style="{StaticResource InputLabelStyle}">
                        <Run Text="ТЕЛЕФОН"/>
                    </TextBlock>
                    <Border Style="{StaticResource InputBorderStyle}">
                        <xctk:MaskedTextBox x:Name="PhoneMaskedBox"
                                            Mask="+7 (000) 000-00-00"
                                            BorderThickness="0" Background="Transparent"
                                            VerticalContentAlignment="Center" Padding="14,0"
                                            FontSize="13"
                                            PromptChar="_"
                                            GotFocus="MaskedBox_GotFocus"
                                            PreviewMouseLeftButtonUp="MaskedBox_PreviewMouseLeftButtonUp"/>
                    </Border>
                </StackPanel>

                <!-- Возраст -->
                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,14">
                    <TextBlock Text="ВОЗРАСТ" Style="{StaticResource InputLabelStyle}"/>
                    <Border Style="{StaticResource InputBorderStyle}">
                        <xctk:MaskedTextBox x:Name="AgeMaskedBox"
                                            Mask="000"
                                            BorderThickness="0" Background="Transparent"
                                            VerticalContentAlignment="Center" Padding="14,0"
                                            FontSize="13"
                                            PromptChar="_"
                                            GotFocus="MaskedBox_GotFocus"
                                            PreviewMouseLeftButtonUp="MaskedBox_PreviewMouseLeftButtonUp"/>
                    </Border>
                </StackPanel>

                <!-- Место работы -->
                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,14">
                    <TextBlock Text="МЕСТО РАБОТЫ" Style="{StaticResource InputLabelStyle}"/>
                    <Border Style="{StaticResource InputBorderStyle}">
                        <TextBox x:Name="WorkplaceBox" Padding="14,0"
                                 BorderThickness="0" VerticalContentAlignment="Center" FontSize="13"
                                 Background="Transparent"/>
                    </Border>
                </StackPanel>

                <!-- Email -->
                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,14">
                    <TextBlock Text="EMAIL" Style="{StaticResource InputLabelStyle}"/>
                    <Border Style="{StaticResource InputBorderStyle}">
                        <TextBox x:Name="EmailBox" Padding="14,0"
                                 BorderThickness="0" VerticalContentAlignment="Center" FontSize="13"
                                 Background="Transparent"/>
                    </Border>
                </StackPanel>

                <!-- Адрес проживания -->
                <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,14">
                    <TextBlock Text="АДРЕС ПРОЖИВАНИЯ" Style="{StaticResource InputLabelStyle}"/>
                    <Border Background="{DynamicResource ThemeSurfaceBrush}" CornerRadius="12"
                            BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1">
                        <TextBox x:Name="ResidenceAddressBox" Height="60" Padding="14,10"
                                 BorderThickness="0" FontSize="13"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="Transparent"/>
                    </Border>
                </StackPanel>

                <!-- Комментарий -->
                <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,14">
                    <TextBlock Text="КОММЕНТАРИЙ" Style="{StaticResource InputLabelStyle}"/>
                    <Border Background="{DynamicResource ThemeSurfaceBrush}" CornerRadius="12"
                            BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1">
                        <TextBox x:Name="CommentBox" Height="80" Padding="14,10"
                                 BorderThickness="0" FontSize="13"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="Transparent"/>
                    </Border>
                </StackPanel>

                <!-- Связь с обучающимся -->
                <StackPanel x:Name="LinkOptionsPanel" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3"
                            Margin="0,0,0,14" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource InputLabelStyle}">
                        <Run Text="ТИП РОДСТВА"/>
                    </TextBlock>
                    <ComboBox x:Name="RelationCombo" Height="42" FontSize="13"
                              VerticalContentAlignment="Center"
                              DisplayMemberPath="Name" SelectedValuePath="Id"
                              Margin="0,0,0,12"/>
                    <Border Background="{DynamicResource ThemeHoverSurfaceBrush}" CornerRadius="12" Padding="16,14"
                            BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <CheckBox x:Name="MainPayerCheck" Content="Основной плательщик"
                                      Margin="0,0,0,10" IsChecked="True"/>
                            <CheckBox x:Name="LegalRepresentativeCheck" Content="Законный представитель"
                                      IsChecked="True"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Сообщение об ошибке -->
                <Border x:Name="ErrorBorder" Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3"
                        Background="{DynamicResource ThemeDangerBgBrush}" CornerRadius="12" Padding="14,10"
                        Margin="0,8,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ThemeDangerFgBrush}"
                               FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </Border>
            </Grid>

            <!-- Кнопки -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Отмена" Width="120"
                        Style="{StaticResource DialogButtonStyle}"
                        Background="{DynamicResource ThemeSurfaceBrush}" Foreground="{DynamicResource ThemeTextBrush}"
                        BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                        Margin="0,0,8,0"
                        Click="Cancel_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="14">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeBgBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Content="Сохранить" Width="140"
                        Style="{StaticResource DialogButtonStyle}"
                        Background="{DynamicResource ThemePrimaryBrush}" Foreground="{DynamicResource ThemeOnPrimaryBrush}"
                        Click="Save_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="14">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemePrimaryHoverBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
