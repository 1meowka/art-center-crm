<Window x:Class="VKR.Views.StudentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Клиенты — Арт-студия"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource ThemeBgBrush}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeBgBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeBorderHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemePrimaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeOnPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemePrimaryHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemePrimaryPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionCardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="28"
                                Padding="32">
                            <Border.Effect>
                                <DropShadowEffect Color="{DynamicResource ThemeShadowColor}"
                                                  BlurRadius="24"
                                                  ShadowDepth="8"
                                                  Opacity="0.06"/>
                            </Border.Effect>
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeHoverSurfaceBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemePrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundedTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ModernDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource ThemeGridLineBrush}"/>
            <Setter Property="RowHeight" Value="24"/>
            <Setter Property="ColumnHeaderHeight" Value="24"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="RowBackground" Value="{DynamicResource ThemeSurfaceBrush}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource ThemeSurfaceBrush}"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource ThemeHoverSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextMutedBrush}"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeBgBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E0E7FF"/>
                    <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource ThemeHeaderBrush}"
                BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="28,16,28,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Resources/logo.png" Width="44" Height="44" Margin="0,0,14,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ТЕКУЩИЙ РАЗДЕЛ" FontSize="11"
                                   FontWeight="Black" Foreground="{DynamicResource ThemeTextSubtleBrush}"/>
                        <TextBlock x:Name="SectionTitleText" Text="Клиенты" FontSize="22"
                                   FontWeight="ExtraBold" Foreground="{DynamicResource ThemeTextBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Button x:Name="BackButton" Content="← Назад" Style="{StaticResource HeaderButtonStyle}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="BackButton_Click"/>
            </Grid>
        </Border>

        <!-- Главное меню раздела -->
        <ScrollViewer x:Name="HubPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,24,28,32">
                <TextBlock Text="Клиенты и представители"
                           FontSize="32" FontWeight="ExtraBold"
                           Foreground="{DynamicResource ThemeTextBrush}"/>
                <TextBlock Text="Выберите, с чем работать: список клиентов (детей) или карточки представителей"
                           FontSize="14" Foreground="{DynamicResource ThemeTextMutedBrush}"
                           Margin="0,4,0,28"/>

                <UniformGrid Columns="2" HorizontalAlignment="Stretch">
                    <Button Style="{StaticResource SectionCardButtonStyle}"
                            Margin="0,0,12,16" MinHeight="220"
                            Click="OpenStudentsView_Click">
                        <StackPanel HorizontalAlignment="Left">
                            <Border Width="64" Height="64" CornerRadius="20"
                                    Background="{DynamicResource ThemeInfoBgBrush}" Margin="0,0,0,18">
                                <TextBlock Text="👤" FontSize="30"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Клиенты" FontSize="28" FontWeight="ExtraBold"
                                       Foreground="{DynamicResource ThemeTextBrush}"/>
                            <TextBlock Text="Действующие, ушедшие, пробные — фильтр по сегменту и приходу"
                                       FontSize="14" Foreground="{DynamicResource ThemeTextMutedBrush}"
                                       TextWrapping="Wrap" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SectionCardButtonStyle}"
                            Margin="12,0,0,16" MinHeight="220"
                            Click="OpenRepresentativesView_Click">
                        <StackPanel HorizontalAlignment="Left">
                            <Border Width="64" Height="64" CornerRadius="20"
                                    Background="{DynamicResource ThemeSuccessBgBrush}" Margin="0,0,0,18">
                                <TextBlock Text="👥" FontSize="30"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Представители" FontSize="28" FontWeight="ExtraBold"
                                       Foreground="{DynamicResource ThemeTextBrush}"/>
                            <TextBlock Text="Родители и опекуны: поиск, карточки, привязка детей к представителю"
                                       FontSize="14" Foreground="{DynamicResource ThemeTextMutedBrush}"
                                       TextWrapping="Wrap" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>
            </StackPanel>
        </ScrollViewer>

        <!-- Обучающиеся -->
        <ScrollViewer x:Name="StudentsPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel Margin="28">
                <Grid Margin="0,0,0,24">
                    <StackPanel HorizontalAlignment="Left">
                        <TextBlock Text="Клиенты" FontSize="32"
                                   FontWeight="ExtraBold" Foreground="{DynamicResource ThemeTextBrush}"/>
                        <TextBlock Text="Действующие, ушедшие, пробные — фильтр по сегменту и приходу"
                                   FontSize="14" Foreground="{DynamicResource ThemeTextMutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="📥  Импорт Excel" Style="{StaticResource HeaderButtonStyle}"
                                Click="ImportClients_Click"/>
                        <Button Content="📤  Экспорт Excel" Style="{StaticResource HeaderButtonStyle}"
                                Click="ExportClients_Click"/>
                        <Button Content="🔄  Обновить" Style="{StaticResource HeaderButtonStyle}"
                                Click="RefreshStudents_Click"/>
                        <Button Content="➕  Добавить обучающегося" Style="{StaticResource PrimaryButtonStyle}"
                                Click="AddStudent_Click"/>
                    </StackPanel>
                </Grid>

                <Border Background="{DynamicResource ThemeSurfaceBrush}" CornerRadius="20" Padding="20"
                        BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="240"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="ПОИСК" FontSize="11" FontWeight="Black"
                                       Foreground="{DynamicResource ThemeTextSubtleBrush}" Margin="0,0,0,6"/>
                            <TextBox x:Name="StudentSearchBox" Style="{StaticResource RoundedTextBoxStyle}"
                                     TextChanged="StudentSearchBox_TextChanged"
                                     ToolTip="ФИО, телефон или представитель"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="СЕГМЕНТ" FontSize="11" FontWeight="Black"
                                       Foreground="{DynamicResource ThemeTextSubtleBrush}" Margin="0,0,0,6"/>
                            <ComboBox x:Name="StatusCombo"
                                      Style="{StaticResource RoundedComboBoxStyle}"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="все"/>
                                <ComboBoxItem Content="действующие"/>
                                <ComboBoxItem Content="ушедшие"/>
                                <ComboBoxItem Content="пробные"/>
                                <ComboBoxItem Content="приостановленные"/>
                                <ComboBoxItem Content="архивные"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="ПРИХОД" FontSize="11" FontWeight="Black"
                                       Foreground="{DynamicResource ThemeTextSubtleBrush}" Margin="0,0,0,6"/>
                            <ComboBox x:Name="IntakePeriodCombo"
                                      Style="{StaticResource RoundedComboBoxStyle}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Key"
                                      SelectionChanged="IntakePeriodCombo_SelectionChanged"/>
                        </StackPanel>

                        <Border Grid.Column="6"
                                Background="{DynamicResource ThemeHoverSurfaceBrush}"
                                CornerRadius="14" Padding="14,8"
                                BorderBrush="{DynamicResource ThemeBorderBrush}"
                                BorderThickness="1"
                                VerticalAlignment="Bottom">
                            <CheckBox x:Name="OnlyMinorsCheck"
                                      Content="только несовершеннолетние"
                                      Checked="OnlyMinorsCheck_Changed"
                                      Unchecked="OnlyMinorsCheck_Changed"/>
                        </Border>
                    </Grid>
                </Border>

                <Border Background="{DynamicResource ThemeSurfaceBrush}" CornerRadius="20" Padding="20"
                        BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="48" Height="48"
                                Background="{DynamicResource ThemeBgBrush}"
                                CornerRadius="16" Margin="0,0,14,0" VerticalAlignment="Center">
                            <TextBlock Text="👤" FontSize="22"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="SelectedStudentTitle"
                                       Text="Клиент не выбран"
                                       FontWeight="ExtraBold" FontSize="16"
                                       Foreground="{DynamicResource ThemeTextBrush}"/>
                            <TextBlock x:Name="SelectedStudentInfo"
                                       Text="Выберите строку для быстрых действий и привязки представителя."
                                       Foreground="{DynamicResource ThemeTextMutedBrush}"
                                       FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>

                        <WrapPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="🔗  Привязать представителя"
                                    Click="AttachRepresentativeToStudent_Click"
                                    Style="{StaticResource PrimaryButtonStyle}"/>
                            <Button Content="Карточка"
                                    Click="OpenStudentCard_Click"
                                    Style="{StaticResource HeaderButtonStyle}"/>
                            <Button Content="✏  Редактировать"
                                    Click="EditStudent_Click"
                                    Style="{StaticResource HeaderButtonStyle}"/>
                        </WrapPanel>
                    </Grid>
                </Border>

                <Border Background="{DynamicResource ThemeSurfaceBrush}" CornerRadius="20" ClipToBounds="True"
                        BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Margin="0,0,0,16">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Padding="20,14"
                                BorderBrush="{DynamicResource ThemeGridLineBrush}" BorderThickness="0,0,0,1">
                            <StackPanel>
                                <TextBlock Text="Список клиентов" FontSize="15"
                                           FontWeight="ExtraBold" Foreground="{DynamicResource ThemeTextBrush}"/>
                                <TextBlock x:Name="StudentsCountText"
                                           Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="11"
                                           FontWeight="SemiBold" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <DataGrid x:Name="StudentsGrid"
                                  Style="{StaticResource ModernDataGridStyle}"
                                  MinHeight="420"
                                  SelectionChanged="StudentsGrid_SelectionChanged"
                                  MouseDoubleClick="StudentsGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="2*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="ДР" Binding="{Binding BirthDateText}" Width="90"/>
                                <DataGridTextColumn Header="ШКОЛА / ДС" Binding="{Binding InstitutionText}" Width="160"/>
                                <DataGridTextColumn Header="МАМА" Binding="{Binding MotherText}" Width="*"/>
                                <DataGridTextColumn Header="ПАПА" Binding="{Binding FatherText}" Width="*"/>
                                <DataGridTextColumn Header="АДРЕС" Binding="{Binding AddressText}" Width="*"/>
                                <DataGridTextColumn Header="КОММЕНТАРИЙ" Binding="{Binding CommentText}" Width="*"/>
                                <DataGridTextColumn Header="ГРУППА" Binding="{Binding GroupDisplay}" Width="100"/>
                                <DataGridTextColumn Header="СТАТУС" Binding="{Binding Status}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <Border x:Name="StudentsErrorBorder" Background="#FF6B6B" Padding="16,12"
                        Visibility="Collapsed">
                    <TextBlock x:Name="StudentsErrorText"
                               Foreground="{DynamicResource ThemeDangerFgBrush}"
                               FontWeight="SemiBold" FontSize="13"
                               TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Представители -->
        <ScrollViewer x:Name="RepresentativesPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel Margin="28">
                <Grid Margin="0,0,0,24">
                    <StackPanel HorizontalAlignment="Left">
                        <TextBlock Text="Представители" FontSize="32"
                                   FontWeight="ExtraBold" Foreground="{DynamicResource ThemeTextBrush}"/>
                        <TextBlock Text="Родители, опекуны и плательщики — привязка детей в один клик"
                                   FontSize="14" Foreground="{DynamicResource ThemeTextMutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="🔄  Обновить" Style="{StaticResource HeaderButtonStyle}"
                                Click="RefreshRepresentatives_Click"/>
                        <Button Content="➕  Добавить представителя" Style="{StaticResource PrimaryButtonStyle}"
                                Click="AddRepresentative_Click"/>
                    </StackPanel>
                </Grid>

                <Border Background="{DynamicResource ThemeSurfaceBrush}" CornerRadius="20" Padding="20"
                        BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid>
                            <StackPanel HorizontalAlignment="Left">
                                <TextBlock Text="Поиск представителей" FontSize="15"
                                           FontWeight="ExtraBold" Foreground="{DynamicResource ThemeTextBrush}"/>
                                <TextBlock Text="ФИО, телефон или имя ребёнка"
                                           Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="11"
                                           FontWeight="SemiBold" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="RepresentativesCountText"
                                       Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="12"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBox x:Name="RepresentativeSearchBox"
                                 Style="{StaticResource RoundedTextBoxStyle}"
                                 Margin="0,12,0,0"
                                 TextChanged="RepresentativeSearchBox_TextChanged"
                                 ToolTip="ФИО, телефон или ребенок"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource ThemeSurfaceBrush}" CornerRadius="20" Padding="20"
                        BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="48" Height="48"
                                Background="{DynamicResource ThemeBgBrush}"
                                CornerRadius="16" Margin="0,0,14,0" VerticalAlignment="Center">
                            <TextBlock Text="👥" FontSize="22"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="SelectedRepresentativeTitle"
                                       Text="Представитель не выбран"
                                       FontWeight="ExtraBold" FontSize="16"
                                       Foreground="{DynamicResource ThemeTextBrush}"/>
                            <TextBlock x:Name="SelectedRepresentativeInfo"
                                       Text="Выберите строку, чтобы привязать ребёнка или открыть карточку."
                                       Foreground="{DynamicResource ThemeTextMutedBrush}"
                                       FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>

                        <WrapPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="🔗  Привязать ребёнка"
                                    Click="AttachStudentToRepresentative_Click"
                                    Style="{StaticResource PrimaryButtonStyle}"/>
                            <Button Content="➕  Новый ребёнок"
                                    Click="AddChildForRepresentative_Click"
                                    Style="{StaticResource HeaderButtonStyle}"/>
                            <Button Content="Карточка"
                                    Click="OpenRepresentativeCard_Click"
                                    Style="{StaticResource HeaderButtonStyle}"/>
                            <Button Content="✏  Редактировать"
                                    Click="EditRepresentative_Click"
                                    Style="{StaticResource HeaderButtonStyle}"/>
                        </WrapPanel>
                    </Grid>
                </Border>

                <Border Background="{DynamicResource ThemeSurfaceBrush}" CornerRadius="20" ClipToBounds="True"
                        BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Margin="0,0,0,16">
                    <DataGrid x:Name="RepresentativesGrid"
                              Style="{StaticResource ModernDataGridStyle}"
                              MinHeight="420"
                              SelectionChanged="RepresentativesGrid_SelectionChanged"
                              MouseDoubleClick="RepresentativesGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="2*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="ТЕЛЕФОН" Binding="{Binding Phone}" Width="*"/>
                            <DataGridTextColumn Header="EMAIL" Binding="{Binding EmailText}" Width="*"/>
                            <DataGridTextColumn Header="ДЕТЕЙ" Binding="{Binding ChildrenText}" Width="90"/>
                            <DataGridTextColumn Header="ДЕТИ" Binding="{Binding ChildrenNames}" Width="2*"/>
                            <DataGridTextColumn Header="ЗАКОННЫЙ" Binding="{Binding LegalBadge}" Width="120"/>
                            <DataGridTextColumn Header="ПЛАТЕЛЬЩИК" Binding="{Binding PayerBadge}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Border x:Name="RepresentativesErrorBorder" Background="#FF6B6B" Padding="16,12"
                        Visibility="Collapsed">
                    <TextBlock x:Name="RepresentativesErrorText"
                               Foreground="{DynamicResource ThemeDangerFgBrush}"
                               FontWeight="SemiBold" FontSize="13"
                               TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
