<Window x:Class="VKR.Views.GroupEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Группа"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource ThemeBgBrush}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="InputBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="42"/>
        </Style>

        <Style x:Key="InputLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSubtleBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="DialogButtonStyle" TargetType="Button" BasedOn="{StaticResource SectionPrimaryButtonStyle}"/>
        <Style x:Key="HeaderButtonStyle" TargetType="Button" BasedOn="{StaticResource SectionHeaderButtonStyle}"/>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource ThemeHeaderBrush}"
                BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="28,16,28,16">
                <StackPanel>
                    <TextBlock Text="ГРУППА" FontSize="11" FontWeight="Black"
                               Foreground="{DynamicResource ThemeTextSubtleBrush}"/>
                    <TextBlock x:Name="DialogTitleText" Text="Новая группа" FontSize="22"
                               FontWeight="ExtraBold" Foreground="{DynamicResource ThemeTextBrush}" Margin="0,2,0,0"/>
                    <TextBlock Text="Направление, преподаватель, лимит и состав группы"
                               FontSize="13" Foreground="{DynamicResource ThemeTextMutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Content="← Закрыть" Style="{StaticResource HeaderButtonStyle}"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Click="Cancel_Click"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,20,28,20">
                <Border Background="{DynamicResource ThemeSurfaceBrush}" CornerRadius="20" Padding="24"
                        BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,14">
                            <TextBlock Style="{StaticResource InputLabelStyle}" Text="НАПРАВЛЕНИЕ (необязательно)"/>
                            <ComboBox x:Name="DirectionCombo" Height="42" FontSize="13"
                                      VerticalContentAlignment="Center"
                                      DisplayMemberPath="Name" SelectedValuePath="Id"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,14">
                            <TextBlock Style="{StaticResource InputLabelStyle}" Text="НОМЕР ГРУППЫ (необязательно)"/>
                            <Border Style="{StaticResource InputBorderStyle}">
                                <TextBox x:Name="GroupNumberBox" Padding="14,0"
                                         BorderThickness="0" VerticalContentAlignment="Center" FontSize="13"
                                         Background="Transparent" Text="1"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,14">
                            <TextBlock Style="{StaticResource InputLabelStyle}" Text="ПРЕПОДАВАТЕЛЬ (необязательно)"/>
                            <ComboBox x:Name="TeacherCombo" Height="42" FontSize="13"
                                      VerticalContentAlignment="Center"
                                      DisplayMemberPath="Name" SelectedValuePath="Id"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,14">
                            <TextBlock Style="{StaticResource InputLabelStyle}" Text="ВОЗРАСТ ОТ (ЛЕТ)"/>
                            <Border Style="{StaticResource InputBorderStyle}">
                                <TextBox x:Name="AgeMinBox" Padding="14,0"
                                         BorderThickness="0" VerticalContentAlignment="Center" FontSize="13"
                                         Background="Transparent"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,14">
                            <TextBlock Style="{StaticResource InputLabelStyle}" Text="ВОЗРАСТ ДО (ЛЕТ)"/>
                            <Border Style="{StaticResource InputBorderStyle}">
                                <TextBox x:Name="AgeMaxBox" Padding="14,0"
                                         BorderThickness="0" VerticalContentAlignment="Center" FontSize="13"
                                         Background="Transparent"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,14">
                            <TextBlock Style="{StaticResource InputLabelStyle}" Text="ПОДПИСЬ ВОЗРАСТНОЙ ГРУППЫ"/>
                            <Border Style="{StaticResource InputBorderStyle}">
                                <TextBox x:Name="AgeBandLabelBox" Padding="14,0"
                                         BorderThickness="0" VerticalContentAlignment="Center" FontSize="13"
                                         Background="Transparent"
                                         ToolTip="Например: Дошкольники до 8 лет"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,14">
                            <TextBlock Style="{StaticResource InputLabelStyle}" Text="МАКС. УЧЕНИКОВ В ГРУППЕ"/>
                            <Border Style="{StaticResource InputBorderStyle}">
                                <TextBox x:Name="MaxStudentsBox" Padding="14,0"
                                         BorderThickness="0" VerticalContentAlignment="Center" FontSize="13"
                                         Background="Transparent"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="{DynamicResource ThemeHoverSurfaceBrush}" CornerRadius="12" Padding="16,14"
                        BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Margin="0,0,0,14">
                    <CheckBox x:Name="IsActiveCheck" Content="группа активна (видна в расписании, идут занятия)"
                              IsChecked="True"/>
                </Border>

                <StackPanel x:Name="MembersPanel" Visibility="Collapsed" Margin="0,0,0,20">
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="УЧЕНИКИ ГРУППЫ" FontSize="16" FontWeight="ExtraBold"
                                   Foreground="{DynamicResource ThemeTextBrush}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="↪ Перевести в другую группу" Style="{StaticResource HeaderButtonStyle}"
                                    Margin="0,0,8,0" Click="TransferMember_Click"/>
                            <Button Content="👤 Карточка ученика" Style="{StaticResource HeaderButtonStyle}"
                                    Click="OpenStudentCard_Click"/>
                        </StackPanel>
                    </Grid>
                    <Border CornerRadius="16" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                            Background="{DynamicResource ThemeSurfaceBrush}" ClipToBounds="True">
                        <DataGrid x:Name="MembersGrid" Background="Transparent" BorderThickness="0"
                                  HeadersVisibility="Column" GridLinesVisibility="None"
                                  HorizontalGridLinesBrush="{DynamicResource ThemeGridLineBrush}"
                                  RowHeight="24" ColumnHeaderHeight="24"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  IsReadOnly="True" SelectionMode="Single"
                                  MinHeight="120" MaxHeight="360"
                                  AlternatingRowBackground="{DynamicResource ThemeSurfaceBrush}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ФИО" Binding="{Binding StudentFullName}" Width="2*"/>
                                <DataGridTextColumn Header="ЗАЧИСЛЕН" Binding="{Binding EnrollmentText}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <TextBlock x:Name="NoMembersText"
                               Text="В группе пока нет учеников."
                               Foreground="{DynamicResource ThemeTextSubtleBrush}" FontSize="12" FontStyle="Italic"
                               Margin="4,8,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource ThemeSurfaceBrush}"
                BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,1,0,0" Padding="28,16">
            <Grid>
                <Border x:Name="ErrorBorder" Background="{DynamicResource ThemeDangerBgBrush}" CornerRadius="12"
                        Padding="14,10" Visibility="Collapsed" HorizontalAlignment="Left" MaxWidth="640">
                    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ThemeDangerFgBrush}"
                               FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="DeleteButton" Grid.Column="0"
                            Content="🗑  Удалить" Width="120"
                            Style="{StaticResource DialogButtonStyle}"
                            Background="#FF6B6B" Foreground="{DynamicResource ThemeDangerFgBrush}"
                            Margin="0" Visibility="Collapsed"
                            Click="Delete_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="14">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#FECACA"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Отмена" Width="120"
                                Style="{StaticResource DialogButtonStyle}"
                                Background="{DynamicResource ThemeSurfaceBrush}" Foreground="{DynamicResource ThemeTextBrush}"
                                BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                                Margin="0,0,8,0"
                                Click="Cancel_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="14">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeBgBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Content="Сохранить" Width="140"
                                Style="{StaticResource DialogButtonStyle}"
                                Background="{DynamicResource ThemePrimaryBrush}" Foreground="{DynamicResource ThemeOnPrimaryBrush}"
                                Click="Save_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="14">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemePrimaryHoverBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
