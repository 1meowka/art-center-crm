<Window x:Class="VKR.Views.VpExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выгрузка ВП"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource ThemeBgBrush}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemePrimaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeOnPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemePrimaryHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeBgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource ThemeSurfaceBrush}"
            CornerRadius="24"
            BorderBrush="{DynamicResource ThemeBorderBrush}"
            BorderThickness="1"
            Margin="16"
            Padding="24">
        <StackPanel>
            <TextBlock Text="Выгрузка операционного отчёта в Excel"
                       FontSize="20"
                       FontWeight="ExtraBold"
                       Foreground="{DynamicResource ThemeTextBrush}"/>
            <TextBlock Text="Планы KPI, интенсивность, ведомость продаж, пробные, ученики года, пришедшие, дебиторка, ушедшие"
                       FontSize="13"
                       Foreground="{DynamicResource ThemeTextMutedBrush}"
                       TextWrapping="Wrap"
                       Margin="0,8,0,20"/>

            <StackPanel Margin="0,0,0,16">
                <RadioButton x:Name="SingleDayRadio"
                             Content="За один день"
                             GroupName="VpPeriodMode"
                             FontSize="14"
                             FontWeight="Bold"
                             Margin="0,0,0,10"
                             Checked="PeriodMode_Changed"/>
                <RadioButton x:Name="PeriodRadio"
                             Content="За период"
                             GroupName="VpPeriodMode"
                             IsChecked="True"
                             FontSize="14"
                             FontWeight="Bold"
                             Checked="PeriodMode_Changed"/>
            </StackPanel>

            <StackPanel x:Name="SingleDayPanel" Visibility="Collapsed" Margin="0,0,0,16">
                <TextBlock Text="Дата" FontSize="12" FontWeight="Bold"
                           Foreground="{DynamicResource ThemeTextSubtleBrush}" Margin="0,0,0,6"/>
                <DatePicker x:Name="SingleDatePicker"
                            SelectedDateFormat="Short"
                            Height="38"/>
            </StackPanel>

            <StackPanel x:Name="PeriodPanel" Margin="0,0,0,16">
                <TextBlock Text="Период" FontSize="12" FontWeight="Bold"
                           Foreground="{DynamicResource ThemeTextSubtleBrush}" Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <DatePicker x:Name="DateFromPicker"
                                Grid.Column="0"
                                SelectedDateFormat="Short"
                                Height="38"/>
                    <TextBlock Grid.Column="1" Text="—"
                               VerticalAlignment="Center"
                               Margin="10,0"
                               Foreground="{DynamicResource ThemeTextSubtleBrush}"/>
                    <DatePicker x:Name="DateToPicker"
                                Grid.Column="2"
                                SelectedDateFormat="Short"
                                Height="38"/>
                </Grid>
            </StackPanel>

            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Учебный год для листа «25-26»" FontSize="12" FontWeight="Bold"
                           Foreground="{DynamicResource ThemeTextSubtleBrush}" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal">
                    <ComboBox x:Name="YearComboBox" Width="120" Height="38" VerticalContentAlignment="Center"/>
                    <TextBlock x:Name="YearEndText" VerticalAlignment="Center" Margin="10,0,0,0"
                               Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="13"/>
                </StackPanel>
            </StackPanel>

            <TextBlock x:Name="StatusText"
                       Text=""
                       FontSize="12"
                       Foreground="{DynamicResource ThemeDangerFgBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        Click="CancelButton_Click"/>
                <Button Content="Выгрузить"
                        Style="{StaticResource PrimaryButtonStyle}"
                        IsDefault="True"
                        Click="ExportButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
