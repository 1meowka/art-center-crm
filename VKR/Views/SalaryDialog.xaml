<Window x:Class="VKR.Views.SalaryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Title="Расчёт ЗП"
        Width="720" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent" AllowsTransparency="True"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="InputBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="42"/>
        </Style>
        <Style x:Key="InputLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSubtleBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource ThemeSurfaceBrush}" CornerRadius="20" Margin="12"
            BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="{DynamicResource ThemeShadowColor}" BlurRadius="40" ShadowDepth="12" Opacity="0.25"/>
        </Border.Effect>
        <StackPanel Margin="32">
            <Grid Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Расчёт зарплаты" FontSize="22"
                               FontWeight="ExtraBold" Foreground="{DynamicResource ThemeTextBrush}"/>
                    <TextBlock x:Name="TeacherNameText" Text=""
                               FontSize="13" Foreground="{DynamicResource ThemeTextMutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Width="32" Height="32" Background="{DynamicResource ThemeBgBrush}"
                        Foreground="{DynamicResource ThemeTextMutedBrush}" BorderThickness="0" Cursor="Hand"
                        Click="Close_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="14">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="ПЕРИОД С" Style="{StaticResource InputLabelStyle}"/>
                    <Border Style="{StaticResource InputBorderStyle}">
                        <xctk:MaskedTextBox x:Name="FromDateBox" Mask="00.00.0000"
                                            BorderThickness="0" Background="Transparent"
                                            VerticalContentAlignment="Center" Padding="14,0"
                                            FontSize="13" PromptChar="_"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="ПЕРИОД ПО" Style="{StaticResource InputLabelStyle}"/>
                    <Border Style="{StaticResource InputBorderStyle}">
                        <xctk:MaskedTextBox x:Name="ToDateBox" Mask="00.00.0000"
                                            BorderThickness="0" Background="Transparent"
                                            VerticalContentAlignment="Center" Padding="14,0"
                                            FontSize="13" PromptChar="_"/>
                    </Border>
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                <Button Content="Этот месяц" Padding="12,7" Margin="0,0,8,0"
                        Background="{DynamicResource ThemeBgBrush}" Foreground="{DynamicResource ThemeTextBrush}" BorderThickness="0"
                        FontWeight="Bold" FontSize="12" Cursor="Hand"
                        Click="ThisMonth_Click"/>
                <Button Content="Прошлый месяц" Padding="12,7" Margin="0,0,8,0"
                        Background="{DynamicResource ThemeBgBrush}" Foreground="{DynamicResource ThemeTextBrush}" BorderThickness="0"
                        FontWeight="Bold" FontSize="12" Cursor="Hand"
                        Click="LastMonth_Click"/>
                <Button Content="Этот год" Padding="12,7" Margin="0,0,8,0"
                        Background="{DynamicResource ThemeBgBrush}" Foreground="{DynamicResource ThemeTextBrush}" BorderThickness="0"
                        FontWeight="Bold" FontSize="12" Cursor="Hand"
                        Click="ThisYear_Click"/>
                <Button Content="Рассчитать" Padding="14,7"
                        Background="{DynamicResource ThemePrimaryBrush}" Foreground="{DynamicResource ThemeOnPrimaryBrush}" BorderThickness="0"
                        FontWeight="Bold" FontSize="12" Cursor="Hand"
                        Click="Calculate_Click"/>
            </StackPanel>

            <Border x:Name="ResultBorder" Background="{DynamicResource ThemeHoverSurfaceBrush}" CornerRadius="16"
                    Padding="24" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="ResultPeriodText" FontSize="12"
                               FontWeight="Black" Foreground="{DynamicResource ThemeTextSubtleBrush}"/>
                    <TextBlock x:Name="ResultTotalText" FontSize="40"
                               FontWeight="Black" Foreground="{DynamicResource ThemeTextBrush}" Margin="0,4,0,16"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="ПРОВЕДЕНО" FontSize="10"
                                       FontWeight="Black" Foreground="{DynamicResource ThemeTextSubtleBrush}"/>
                            <TextBlock x:Name="LessonsHeldText" FontSize="22"
                                       FontWeight="ExtraBold" Foreground="{DynamicResource ThemeTextBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="ЧАСОВ" FontSize="10"
                                       FontWeight="Black" Foreground="{DynamicResource ThemeTextSubtleBrush}"/>
                            <TextBlock x:Name="HoursText" FontSize="22"
                                       FontWeight="ExtraBold" Foreground="{DynamicResource ThemeTextBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="ПОСЕЩЕНИЙ" FontSize="10"
                                       FontWeight="Black" Foreground="{DynamicResource ThemeTextSubtleBrush}"/>
                            <TextBlock x:Name="VisitsText" FontSize="22"
                                       FontWeight="ExtraBold" Foreground="{DynamicResource ThemeTextBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="СТАВКА" FontSize="10"
                                       FontWeight="Black" Foreground="{DynamicResource ThemeTextSubtleBrush}"/>
                            <TextBlock x:Name="RateText" FontSize="22"
                                       FontWeight="ExtraBold" Foreground="{DynamicResource ThemeTextBrush}"/>
                        </StackPanel>
                    </Grid>
                    <Border Background="{DynamicResource ThemeInfoBgBrush}" CornerRadius="14"
                            Padding="14,10" Margin="0,16,0,0">
                        <TextBlock FontSize="12" Foreground="{DynamicResource ThemeInfoFgBrush}" TextWrapping="Wrap">
                            <Run Text="Формула:"/>
                            <Run Text=" ставка за занятие × количество проведённых занятий" FontWeight="Bold"/>
                            <Run Text=". Часы считаются отдельно: 1 занятие = "/>
                            <Run x:Name="LessonHoursText" FontWeight="Bold"/>
                            <Run Text=". Проведённым считается занятие, где есть хотя бы одна отметка посещаемости."/>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Border>

            <Border x:Name="ErrorBorder" Background="{DynamicResource ThemeDangerBgBrush}" CornerRadius="12"
                    Padding="14,10" Margin="0,8,0,0" Visibility="Collapsed">
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ThemeDangerFgBrush}"
                           FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </Border>

            <Button Content="Закрыть" Width="120" Height="42"
                    HorizontalAlignment="Right" Margin="0,20,0,0"
                    Background="{DynamicResource ThemePrimaryBrush}" Foreground="{DynamicResource ThemeOnPrimaryBrush}" BorderThickness="0"
                    FontWeight="Bold" FontSize="13" Cursor="Hand"
                    Click="Close_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemePrimaryHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Border>
</Window>
