<Window x:Class="VKR.Views.MaxBotSubscribersDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подписчики бота MAX"
        Width="640" Height="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeBgBrush}"
        FontFamily="Segoe UI">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Подписчики бота" FontSize="20" FontWeight="ExtraBold"/>
            <TextBlock Text="chat_id можно узнать после первого сообщения клиента боту или из логов API."
                       FontSize="12" Foreground="{DynamicResource ThemeTextMutedBrush}" TextWrapping="Wrap"/>
        </StackPanel>

        <DataGrid x:Name="Grid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ИМЯ" Binding="{Binding DisplayName}" Width="*"/>
                <DataGridTextColumn Header="CHAT ID" Binding="{Binding MaxChatId}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="＋ Добавить" Padding="14,8" Margin="0,0,8,0" Click="Add_Click"/>
            <Button Content="🗑 Удалить" Padding="14,8" Margin="0,0,8,0" Click="Delete_Click"/>
            <Button Content="Закрыть" Padding="14,8" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
