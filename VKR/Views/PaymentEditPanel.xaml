<UserControl x:Class="VKR.Views.PaymentEditPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="MiniLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSubtleBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="MiniBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="FieldComboStyle" TargetType="ComboBox" BasedOn="{StaticResource RoundedComboBoxStyle}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="ErrorBorder" Grid.Row="0" Background="#FF6B6B" CornerRadius="10"
                Padding="12,10" Margin="0,0,0,12" Visibility="Collapsed">
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ThemeDangerFgBrush}"
                       FontWeight="SemiBold" TextWrapping="Wrap" FontSize="13"/>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource ThemeSurfaceBrush}" CornerRadius="16"
                    BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Клиент и услуга" Style="{StaticResource CardTitleStyle}"/>

                    <Grid Grid.Row="1" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="ПРИЗНАК" Style="{StaticResource MiniLabelStyle}"/>
                            <ComboBox x:Name="KindCombo" Style="{StaticResource FieldComboStyle}"
                                      IsEditable="True" IsTextSearchEnabled="False"
                                      SelectionChanged="KindCombo_Changed"/>
                        </StackPanel>
                        <CheckBox x:Name="HasContractBox" Grid.Column="2" Content="Наличие договора"
                                  FontSize="14" FontWeight="SemiBold" IsChecked="True"
                                  Foreground="{DynamicResource ThemeTextBrush}"
                                  VerticalAlignment="Bottom" Margin="0,0,0,10"/>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="КЛИЕНТ" Style="{StaticResource MiniLabelStyle}"/>
                            <TextBox x:Name="ClientBox" Style="{StaticResource MiniBoxStyle}" IsReadOnly="True"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="Найти" Padding="18,0" Height="40" FontSize="14" FontWeight="Bold"
                                VerticalAlignment="Bottom" Click="FindClient_Click"/>
                    </Grid>

                    <StackPanel x:Name="ContractFields" Grid.Row="3" Margin="0,0,0,14">
                        <TextBlock Text="ДОГОВОР" Style="{StaticResource MiniLabelStyle}"/>
                        <ComboBox x:Name="ContractCombo" Style="{StaticResource FieldComboStyle}"
                                  DisplayMemberPath="Name" SelectedValuePath="Id"
                                  IsEditable="True" IsTextSearchEnabled="False"
                                  SelectionChanged="ContractCombo_SelectionChanged"
                                  DropDownClosed="ContractCombo_DropDownClosed"/>
                    </StackPanel>

                    <Grid Grid.Row="4" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="DirectionFields">
                            <TextBlock Text="НАПРАВЛЕНИЕ / КУРС" Style="{StaticResource MiniLabelStyle}"/>
                            <ComboBox x:Name="DirectionCombo" Style="{StaticResource FieldComboStyle}"
                                      DisplayMemberPath="Name" SelectedValuePath="Id"/>
                        </StackPanel>
                        <StackPanel x:Name="TimesFields" Grid.Column="2">
                            <TextBlock Text="РАЗ / НЕД." Style="{StaticResource MiniLabelStyle}"/>
                            <ComboBox x:Name="TimesPerWeekCombo" Style="{StaticResource FieldComboStyle}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel x:Name="ServiceFields" Margin="0,0,0,14" Visibility="Collapsed">
                            <TextBlock Text="СОБЫТИЕ / УСЛУГА" Style="{StaticResource MiniLabelStyle}"/>
                            <ComboBox x:Name="ServiceCombo" Style="{StaticResource FieldComboStyle}"
                                      IsEditable="True" IsTextSearchEnabled="False"/>
                        </StackPanel>
                        <StackPanel x:Name="EventFields" Grid.Row="1" Visibility="Collapsed">
                            <TextBlock Text="ТЕКСТ СОБЫТИЯ" Style="{StaticResource MiniLabelStyle}"/>
                            <TextBox x:Name="EventBox" MinHeight="80" Padding="10,8" FontSize="14"
                                     TextWrapping="Wrap" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{DynamicResource ThemeSurfaceBrush}" CornerRadius="16"
                    BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Расчёт" Style="{StaticResource CardTitleStyle}"/>

                    <Grid Grid.Row="1" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="ДАТА ВНЕСЕНИЯ" Style="{StaticResource MiniLabelStyle}"/>
                            <DatePicker x:Name="PaymentDatePicker" Height="40" FontSize="14"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="ФАКТИЧЕСКАЯ ДАТА" Style="{StaticResource MiniLabelStyle}"/>
                            <DatePicker x:Name="ActualDatePicker" Height="40" FontSize="14"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="ПЕРИОД" Style="{StaticResource MiniLabelStyle}"/>
                            <ComboBox x:Name="PeriodCombo" Style="{StaticResource FieldComboStyle}"
                                      IsEditable="True" IsTextSearchEnabled="False"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="МЕНЕДЖЕР" Style="{StaticResource MiniLabelStyle}"/>
                            <ComboBox x:Name="ManagerCombo" Style="{StaticResource FieldComboStyle}"
                                      DisplayMemberPath="Name" SelectedValuePath="Id"
                                      IsEditable="True" IsTextSearchEnabled="False"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="СУММА, ₽" Style="{StaticResource MiniLabelStyle}"/>
                            <TextBox x:Name="AmountBox" Style="{StaticResource MiniBoxStyle}"
                                     TextChanged="Totals_Changed"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="СКИДКА, %" Style="{StaticResource MiniLabelStyle}"/>
                            <TextBox x:Name="DiscountBox" Style="{StaticResource MiniBoxStyle}"
                                     TextChanged="Totals_Changed"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="ИТОГО, ₽" Style="{StaticResource MiniLabelStyle}"/>
                            <TextBox x:Name="TotalBox" Style="{StaticResource MiniBoxStyle}" IsReadOnly="True"
                                     FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="4" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="ТИП ОПЛАТЫ" Style="{StaticResource MiniLabelStyle}"/>
                            <ComboBox x:Name="PaymentMethodCombo" Style="{StaticResource FieldComboStyle}"
                                      DisplayMemberPath="Name" SelectedValuePath="Id"
                                      IsEditable="True" IsTextSearchEnabled="False"/>
                        </StackPanel>
                        <CheckBox x:Name="CashReceiptBox" Grid.Column="2" Content="Кассовый чек"
                                  FontSize="14" FontWeight="SemiBold"
                                  Foreground="{DynamicResource ThemeTextBrush}"
                                  VerticalAlignment="Bottom" Margin="0,0,0,10"/>
                    </Grid>

                    <StackPanel Grid.Row="5">
                        <TextBlock Text="ПРИМЕЧАНИЕ" Style="{StaticResource MiniLabelStyle}"/>
                        <TextBox x:Name="CommentBox" MinHeight="120" Padding="12,10" FontSize="14"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 VerticalAlignment="Stretch"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Отмена" Padding="28,12" FontWeight="Bold" FontSize="14"
                    MinWidth="140" Click="Cancel_Click"/>
            <Button Content="Сохранить" Padding="28,12" FontWeight="Bold" FontSize="14"
                    MinWidth="160" Margin="10,0,0,0"
                    Background="{DynamicResource ThemePrimaryBrush}"
                    Foreground="{DynamicResource ThemeOnPrimaryBrush}"
                    BorderThickness="0" Cursor="Hand" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
