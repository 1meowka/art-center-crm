<Window x:Class="VKR.Views.MaxBotSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки бота MAX"
        Width="620" Height="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        MinHeight="520"
        Background="{DynamicResource ThemeBgBrush}"
        FontFamily="Segoe UI">

    <Border Margin="24" Background="{DynamicResource ThemeSurfaceBrush}"
            CornerRadius="20" Padding="24"
            BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="Настройки бота MAX" FontSize="22" FontWeight="ExtraBold"
                           Foreground="{DynamicResource ThemeTextBrush}"/>
                <TextBlock Text="Токен: business.max.ru → Чат-боты → Расширенные настройки. Юридические поля обязательны для модерации MAX."
                           FontSize="13" Foreground="{DynamicResource ThemeTextMutedBrush}"
                           TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="ТОКЕН БОТА" FontSize="11" FontWeight="Black"
                               Foreground="{DynamicResource ThemeTextSubtleBrush}" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="TokenBox" Height="42" Padding="12,0"
                                 VerticalContentAlignment="Center" FontSize="13"
                                 Margin="0,0,0,6"/>
                    <TextBlock x:Name="TokenHintText"
                               Text="Токен хранится в БД в зашифрованном виде (Windows DPAPI)."
                               FontSize="11" Foreground="{DynamicResource ThemeTextSubtleBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <TextBlock Text="ОРГАНИЗАЦИЯ (ДЛЯ ЮР. ИНФОРМАЦИИ В БОТЕ)" FontSize="11" FontWeight="Black"
                               Foreground="{DynamicResource ThemeTextSubtleBrush}" Margin="0,0,0,6"/>
                    <TextBlock Text="Название" FontSize="12" Foreground="{DynamicResource ThemeTextMutedBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="OrgNameBox" Height="38" Padding="12,0" VerticalContentAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Адрес" FontSize="12" Foreground="{DynamicResource ThemeTextMutedBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="OrgAddressBox" Height="38" Padding="12,0" VerticalContentAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="ИНН" FontSize="12" Foreground="{DynamicResource ThemeTextMutedBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="OrgInnBox" Height="38" Padding="12,0" VerticalContentAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Телефон поддержки" FontSize="12" Foreground="{DynamicResource ThemeTextMutedBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="SupportPhoneBox" Height="38" Padding="12,0" VerticalContentAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="E-mail поддержки" FontSize="12" Foreground="{DynamicResource ThemeTextMutedBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="SupportEmailBox" Height="38" Padding="12,0" VerticalContentAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="URL политики конфиденциальности (https://)" FontSize="12" Foreground="{DynamicResource ThemeTextMutedBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="PrivacyUrlBox" Height="38" Padding="12,0" VerticalContentAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="URL пользовательского соглашения (https://)" FontSize="12" Foreground="{DynamicResource ThemeTextMutedBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TermsUrlBox" Height="38" Padding="12,0" VerticalContentAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Приветствие /start (необязательно; иначе — стандартный текст)" FontSize="12"
                               Foreground="{DynamicResource ThemeTextMutedBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="WelcomeTextBox" MinHeight="72" Padding="12,8" TextWrapping="Wrap"
                             AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"/>
                    <TextBlock Text="Текст команды /скидки (необязательно; иначе — шаблон)" FontSize="12"
                               Foreground="{DynamicResource ThemeTextMutedBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="DiscountsTextBox" MinHeight="72" Padding="12,8" TextWrapping="Wrap"
                             AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"/>

                    <TextBlock x:Name="StatusText" FontSize="13" TextWrapping="Wrap"
                               Foreground="{DynamicResource ThemeTextMutedBrush}" Margin="0,0,0,8"/>
                    <TextBlock x:Name="ErrorText" FontSize="13" TextWrapping="Wrap"
                               Foreground="#EF4444" FontWeight="SemiBold" Visibility="Collapsed"/>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Отключить бота" Padding="16,9" Margin="0,0,8,0" Click="Clear_Click"/>
                <Button Content="Проверить" Padding="16,9" Margin="0,0,8,0" Click="Test_Click"/>
                <Button Content="Отмена" Padding="16,9" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button Content="Сохранить" Padding="16,9" FontWeight="Bold" Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
