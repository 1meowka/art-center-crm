<Window x:Class="VKR.Views.CalendarEventEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Событие"
        Width="680" SizeToContent="Height" MaxHeight="900"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="InputBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="42"/>
        </Style>
        <Style x:Key="InputLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSubtleBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource ThemeSurfaceBrush}" CornerRadius="20" Margin="12"
            BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="{DynamicResource ThemeShadowColor}" BlurRadius="40"
                              ShadowDepth="12" Opacity="0.25"/>
        </Border.Effect>
        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="820">
            <StackPanel Margin="32">
                <Grid Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock x:Name="DialogTitleText" Text="Новое событие" FontSize="22"
                                   FontWeight="ExtraBold" Foreground="{DynamicResource ThemeTextBrush}"/>
                        <TextBlock Text="Мастер-класс или открытое пробное — появится в пробных занятиях"
                                   FontSize="13" Foreground="{DynamicResource ThemeTextMutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Width="32" Height="32" Background="{DynamicResource ThemeBgBrush}"
                            Foreground="{DynamicResource ThemeTextMutedBrush}" BorderThickness="0" Cursor="Hand"
                            Click="Cancel_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="14">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <StackPanel Margin="0,0,0,14">
                    <TextBlock Style="{StaticResource InputLabelStyle}">
                        <Run Text="НАЗВАНИЕ"/>
                    </TextBlock>
                    <Border Style="{StaticResource InputBorderStyle}">
                        <TextBox x:Name="TitleBox" Padding="14,0" BorderThickness="0"
                                 VerticalContentAlignment="Center" FontSize="13" Background="Transparent"
                                 ToolTip="Например: Хантыйский рисунок"/>
                    </Border>
                </StackPanel>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource InputLabelStyle}" Text="ТИП СОБЫТИЯ"/>
                        <ComboBox x:Name="EventTypeCombo" Height="42" FontSize="13"
                                  VerticalContentAlignment="Center"
                                  DisplayMemberPath="Label"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource InputLabelStyle}" Text="МАКС. УЧАСТНИКОВ"/>
                        <Border Style="{StaticResource InputBorderStyle}">
                            <TextBox x:Name="MaxParticipantsBox" Padding="14,0" BorderThickness="0"
                                     VerticalContentAlignment="Center" FontSize="13" Background="Transparent"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <StackPanel Margin="0,0,0,14">
                    <TextBlock Style="{StaticResource InputLabelStyle}" Text="НАПРАВЛЕНИЕ"/>
                    <ComboBox x:Name="DirectionCombo" Height="42" FontSize="13"
                              VerticalContentAlignment="Center"
                              DisplayMemberPath="Name" SelectedValuePath="Id"/>
                </StackPanel>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource InputLabelStyle}" Text="ПРЕПОДАВАТЕЛЬ"/>
                        <ComboBox x:Name="TeacherCombo" Height="42" FontSize="13"
                                  VerticalContentAlignment="Center"
                                  DisplayMemberPath="Name" SelectedValuePath="Id"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource InputLabelStyle}" Text="КАБИНЕТ"/>
                        <ComboBox x:Name="ClassroomCombo" Height="42" FontSize="13"
                                  VerticalContentAlignment="Center"
                                  DisplayMemberPath="Name" SelectedValuePath="Id"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource InputLabelStyle}">
                            <Run Text="ДАТА"/>
                        </TextBlock>
                        <DatePicker x:Name="EventDatePicker" Height="42" FontSize="13"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource InputLabelStyle}" Text="НАЧАЛО"/>
                        <Border Style="{StaticResource InputBorderStyle}">
                            <TextBox x:Name="TimeStartBox" Padding="14,0" BorderThickness="0"
                                     VerticalContentAlignment="Center" FontSize="13" Background="Transparent"
                                     Text="15:00"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Style="{StaticResource InputLabelStyle}" Text="ОКОНЧАНИЕ"/>
                        <Border Style="{StaticResource InputBorderStyle}">
                            <TextBox x:Name="TimeEndBox" Padding="14,0" BorderThickness="0"
                                     VerticalContentAlignment="Center" FontSize="13" Background="Transparent"
                                     Text="16:30"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <StackPanel Margin="0,0,0,14">
                    <TextBlock Style="{StaticResource InputLabelStyle}" Text="ОПИСАНИЕ"/>
                    <Border Background="{DynamicResource ThemeSurfaceBrush}" CornerRadius="12"
                            BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                            MinHeight="80">
                        <TextBox x:Name="DescriptionBox" Padding="14,10" BorderThickness="0"
                                 FontSize="13" Background="Transparent" TextWrapping="Wrap"
                                 AcceptsReturn="True" MinHeight="76" VerticalScrollBarVisibility="Auto"/>
                    </Border>
                </StackPanel>

                <Border Background="{DynamicResource ThemeHoverSurfaceBrush}" CornerRadius="12" Padding="16,14"
                        BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Margin="0,0,0,14">
                    <CheckBox x:Name="IsActiveCheck" Content="событие активно (видно в пробных занятиях)"
                              IsChecked="True"/>
                </Border>

                <Border x:Name="ErrorBorder" Background="{DynamicResource ThemeDangerBgBrush}" CornerRadius="12"
                        Padding="14,10" Margin="0,4,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ThemeDangerFgBrush}"
                               FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </Border>

                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="DeleteButton" Grid.Column="0" Content="🗑  Удалить" Width="120"
                            Style="{StaticResource DialogButtonStyle}"
                            Background="#FF6B6B" Foreground="{DynamicResource ThemeDangerFgBrush}"
                            Visibility="Collapsed" Click="Delete_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="14">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#FECACA"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Отмена" Width="120" Style="{StaticResource DialogButtonStyle}"
                                Background="{DynamicResource ThemeSurfaceBrush}" Foreground="{DynamicResource ThemeTextBrush}"
                                BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                                Margin="0,0,8,0" Click="Cancel_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeBgBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="Сохранить" Width="140" Style="{StaticResource DialogButtonStyle}"
                                Background="{DynamicResource ThemePrimaryBrush}" Foreground="{DynamicResource ThemeOnPrimaryBrush}"
                                Click="Save_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="14">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemePrimaryHoverBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
