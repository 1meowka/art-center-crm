<Window x:Class="VKR.Views.TrialResultPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Результат пробного"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        FontFamily="Segoe UI">

    <Border Background="{DynamicResource ThemeSurfaceBrush}" CornerRadius="20" Margin="12"
            BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1">
        <StackPanel Margin="28">
            <TextBlock Text="Результат пробного занятия" FontSize="20" FontWeight="ExtraBold"
                       Foreground="{DynamicResource ThemeTextBrush}"/>
            <TextBlock x:Name="SummaryText" Margin="0,6,0,16"
                       Foreground="{DynamicResource ThemeTextMutedBrush}" TextWrapping="Wrap"/>

            <TextBlock Text="РЕЗУЛЬТАТ" FontSize="11" FontWeight="Black"
                       Foreground="{DynamicResource ThemeTextSubtleBrush}" Margin="0,0,0,6"/>
            <ComboBox x:Name="ResultCombo" Height="42" FontSize="13"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Отмена" Width="110" Height="40" Margin="0,0,8,0"
                        Style="{StaticResource SectionHeaderButtonStyle}"
                        Click="Cancel_Click"/>
                <Button Content="Сохранить" Width="130" Height="40"
                        Style="{StaticResource SectionPrimaryButtonStyle}"
                        Click="Save_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
