<Window x:Class="VKR.Views.ClientNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заметки по клиенту"
        Width="640" Height="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeBgBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Заметки для администраторов" FontSize="20" FontWeight="ExtraBold"/>
            <TextBlock x:Name="SubtitleText" FontSize="13" Foreground="{DynamicResource ThemeTextMutedBrush}"
                       TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" CornerRadius="16" BorderBrush="{DynamicResource ThemeBorderBrush}"
                BorderThickness="1" ClipToBounds="True">
            <ListBox x:Name="NotesList" BorderThickness="0" Padding="8">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource ThemeHoverSurfaceBrush}" CornerRadius="12"
                                Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="{Binding NoteText}" TextWrapping="Wrap" FontSize="13"/>
                                <TextBlock FontSize="11" Foreground="{DynamicResource ThemeTextMutedBrush}" Margin="0,6,0,0">
                                    <Run Text="{Binding AuthorName}"/>
                                    <Run Text=" · "/>
                                    <Run Text="{Binding CreatedAtText}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <TextBlock x:Name="EmptyText" Grid.Row="1"
                   Text="Заметок пока нет — добавьте первую ниже."
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{DynamicResource ThemeTextSubtleBrush}" FontStyle="Italic"/>

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="НОВАЯ ЗАМЕТКА" FontSize="11" FontWeight="Black"
                       Foreground="{DynamicResource ThemeTextSubtleBrush}" Margin="0,0,0,6"/>
            <TextBox x:Name="NewNoteBox" MinHeight="72" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" Padding="10" FontSize="13"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Закрыть" Padding="16,9" Margin="0,0,8,0" Click="Close_Click"/>
            <Button Content="Добавить заметку" Padding="16,9" FontWeight="Bold"
                    Background="{DynamicResource ThemePrimaryBrush}"
                    Foreground="{DynamicResource ThemeOnPrimaryBrush}"
                    BorderThickness="0" Click="AddNote_Click"/>
        </StackPanel>
    </Grid>
</Window>
