<Window x:Class="VKR.Views.DictionaryEntryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Запись справочника"
        Width="540" SizeToContent="Height"
        MinWidth="420" MinHeight="160"
        WindowStartupLocation="CenterOwner"
        WindowStyle="SingleBorderWindow" ResizeMode="CanMinimize"
        Background="{DynamicResource ThemeSurfaceBrush}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="InputBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="42"/>
        </Style>
        <Style x:Key="InputLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSubtleBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource ThemeSurfaceBrush}" CornerRadius="8" Margin="8"
            BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1">
        <StackPanel Margin="20">
            <Grid Margin="0,0,0,16">
                <TextBlock x:Name="DialogTitleText" Text="Новая запись" FontSize="20"
                           FontWeight="ExtraBold" Foreground="{DynamicResource ThemeTextBrush}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Свернуть" Padding="10,6" FontSize="12" FontWeight="Bold"
                            Background="{DynamicResource ThemeBgBrush}"
                            Foreground="{DynamicResource ThemeTextMutedBrush}" BorderThickness="0" Cursor="Hand"
                            Click="Minimize_Click" Margin="0,0,6,0"/>
                    <Button Content="✕" Width="32" Height="32" Background="{DynamicResource ThemeBgBrush}"
                            Foreground="{DynamicResource ThemeTextMutedBrush}" BorderThickness="0" Cursor="Hand"
                            Click="Cancel_Click"/>
                </StackPanel>
            </Grid>

            <!-- Название (всегда есть) -->
            <StackPanel Margin="0,0,0,14">
                <TextBlock x:Name="NameLabel" Text="НАЗВАНИЕ" Style="{StaticResource InputLabelStyle}"/>
                <Border Style="{StaticResource InputBorderStyle}">
                    <TextBox x:Name="NameBox" Padding="14,0" BorderThickness="0"
                             VerticalContentAlignment="Center" FontSize="13" Background="Transparent"/>
                </Border>
            </StackPanel>

            <!-- Динамические поля -->
            <StackPanel x:Name="ExtraFieldsPanel"/>

            <!-- Ошибка -->
            <Border x:Name="ErrorBorder" Background="{DynamicResource ThemeDangerBgBrush}" CornerRadius="12"
                    Padding="14,10" Margin="0,8,0,0" Visibility="Collapsed">
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ThemeDangerFgBrush}"
                           FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </Border>

            <!-- Кнопки -->
            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="DeleteButton" Grid.Column="0"
                        Content="🗑  Удалить" Width="120" Height="42"
                        Background="#FF6B6B" Foreground="{DynamicResource ThemeDangerFgBrush}"
                        FontWeight="Bold" FontSize="13"
                        BorderThickness="0" Cursor="Hand"
                        Visibility="Collapsed" Click="Delete_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="14">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#FECACA"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Отмена" Width="120" Height="42"
                            Background="{DynamicResource ThemeSurfaceBrush}" Foreground="{DynamicResource ThemeTextBrush}"
                            BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                            FontWeight="Bold" FontSize="13" Cursor="Hand"
                            Margin="0,0,8,0" Click="Cancel_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="14">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeBgBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="Сохранить" Width="140" Height="42"
                            Background="{DynamicResource ThemePrimaryBrush}" Foreground="{DynamicResource ThemeOnPrimaryBrush}"
                            FontWeight="Bold" FontSize="13" Cursor="Hand"
                            BorderThickness="0" Click="Save_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="14">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemePrimaryHoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>
