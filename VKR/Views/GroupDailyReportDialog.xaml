<Window x:Class="VKR.Views.GroupDailyReportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Отчёт посещаемости за день"
        Width="920" Height="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeBgBrush}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="HeaderButtonStyle" TargetType="Button" BasedOn="{StaticResource SectionHeaderButtonStyle}"/>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SectionPrimaryButtonStyle}"/>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Ежедневный отчёт по группам"
                   FontSize="24" FontWeight="ExtraBold" Margin="0,0,0,8"/>
        <TextBlock Grid.Row="1"
                   Text="Укажите количество обучающихся и пробников по каждой группе, у которой занятие в этот день"
                   Foreground="{DynamicResource ThemeTextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>

        <DataGrid x:Name="ReportGrid" Grid.Row="2" AutoGenerateColumns="False"
                  Style="{StaticResource ModernDataGridStyle}" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ГРУППА" Binding="{Binding GroupTitle}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="ПРЕПОДАВАТЕЛЬ" Binding="{Binding TeacherName}" Width="160" IsReadOnly="True"/>
                <DataGridTextColumn Header="УЧЕНИКОВ" Binding="{Binding StudentsPresent, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                <DataGridTextColumn Header="ПРОБНИКОВ" Binding="{Binding TrialPresent, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                <DataGridTextColumn Header="КОММЕНТАРИЙ" Binding="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="SummaryText" Grid.Row="3" Margin="0,12,0,0"
                   FontSize="13" FontWeight="SemiBold"
                   Foreground="{DynamicResource ThemeTextMutedBrush}"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Отмена" Style="{StaticResource HeaderButtonStyle}"
                    Width="120" Height="40" Margin="0,0,10,0" Click="Cancel_Click"/>
            <Button Content="Сохранить" Style="{StaticResource PrimaryButtonStyle}"
                    Width="140" Height="40" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
