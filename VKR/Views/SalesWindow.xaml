<Window x:Class="VKR.Views.SalesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Продажи"
        WindowStyle="None"
        WindowState="Maximized"
        Background="{DynamicResource ThemeBgBrush}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeBgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemePrimaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeOnPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemePrimaryHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundedTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource ThemeGridLineBrush}"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeight" Value="24"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="ColumnHeaderHeight" Value="24"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
            <Setter Property="RowBackground" Value="{DynamicResource ThemeSurfaceBrush}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource ThemeSurfaceBrush}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ШАПКА -->
        <Border Grid.Row="0" Background="{DynamicResource ThemeHeaderBrush}"
                BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="28,16,28,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Resources/logo.png" Width="44" Height="44" Margin="0,0,14,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ТЕКУЩИЙ РАЗДЕЛ" FontSize="11"
                                   FontWeight="Black" Foreground="{DynamicResource ThemeTextSubtleBrush}"/>
                        <TextBlock Text="Продажи" FontSize="22"
                                   FontWeight="ExtraBold" Foreground="{DynamicResource ThemeTextBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Button Content="← Назад" Style="{StaticResource HeaderButtonStyle}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="BackButton_Click"/>
            </Grid>
        </Border>

        <!-- КОНТЕНТ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28">

                <!-- Заголовок раздела + кнопки -->
                <Grid Margin="0,0,0,24">
                    <StackPanel HorizontalAlignment="Left">
                        <TextBlock Text="Учёт продаж" FontSize="32"
                                   FontWeight="ExtraBold" Foreground="{DynamicResource ThemeTextBrush}"/>
                        <TextBlock Text="Реализация товаров и услуг с фильтрацией по периоду"
                                   FontSize="14" Foreground="{DynamicResource ThemeTextMutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="➕  Новая продажа"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="AddSale_Click"/>
                    </StackPanel>
                </Grid>

                <!-- KPI -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{DynamicResource ThemeSurfaceBrush}" CornerRadius="20" Padding="20"
                            BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="ВЫРУЧКА ЗА ПЕРИОД" FontSize="11" FontWeight="Black"
                                       Foreground="{DynamicResource ThemeTextSubtleBrush}"/>
                            <TextBlock x:Name="TotalRevenueText" Text="0 ₽" FontSize="22"
                                       FontWeight="ExtraBold" Foreground="{DynamicResource ThemeTextBrush}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="{DynamicResource ThemeSurfaceBrush}" CornerRadius="20" Padding="20"
                            BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="КОЛИЧЕСТВО ПРОДАЖ" FontSize="11" FontWeight="Black"
                                       Foreground="{DynamicResource ThemeTextSubtleBrush}"/>
                            <TextBlock x:Name="TotalCountText" Text="0" FontSize="22"
                                       FontWeight="ExtraBold" Foreground="{DynamicResource ThemeTextBrush}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Фильтры -->
                <Border Background="{DynamicResource ThemeSurfaceBrush}" CornerRadius="20" Padding="20" Margin="0,0,0,16"
                        BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="160"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="ПОИСК" FontSize="11" FontWeight="Black"
                                           Foreground="{DynamicResource ThemeTextSubtleBrush}" Margin="0,0,0,6"/>
                                <TextBox x:Name="SearchBox" Style="{StaticResource RoundedTextBoxStyle}"
                                         TextChanged="SearchBox_TextChanged"
                                         ToolTip="Наименование, ФИО"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="С ДАТЫ" FontSize="11" FontWeight="Black"
                                           Foreground="{DynamicResource ThemeTextSubtleBrush}" Margin="0,0,0,6"/>
                                <DatePicker x:Name="DateFromPicker"
                                            SelectedDateChanged="DateFilter_Changed"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="ПО ДАТУ" FontSize="11" FontWeight="Black"
                                           Foreground="{DynamicResource ThemeTextSubtleBrush}" Margin="0,0,0,6"/>
                                <DatePicker x:Name="DateToPicker"
                                            SelectedDateChanged="DateFilter_Changed"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="220"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="СОРТИРОВКА" FontSize="11" FontWeight="Black"
                                           Foreground="{DynamicResource ThemeTextSubtleBrush}" Margin="0,0,0,6"/>
                                <ComboBox x:Name="SortCombo" Height="38" FontSize="13"
                                          SelectionChanged="SortFilter_Changed">
                                    <ComboBoxItem Content="Дата — новые сверху" Tag="DateDesc" IsSelected="True"/>
                                    <ComboBoxItem Content="Дата — старые сверху" Tag="DateAsc"/>
                                    <ComboBoxItem Content="Сумма — по убыванию" Tag="AmountDesc"/>
                                    <ComboBoxItem Content="Сумма — по возрастанию" Tag="AmountAsc"/>
                                    <ComboBoxItem Content="Наименование А → Я" Tag="ItemAsc"/>
                                    <ComboBoxItem Content="Наименование Я → А" Tag="ItemDesc"/>
                                    <ComboBoxItem Content="Клиент А → Я" Tag="StudentAsc"/>
                                    <ComboBoxItem Content="Клиент Я → А" Tag="StudentDesc"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="ГОД" FontSize="11" FontWeight="Black"
                                           Foreground="{DynamicResource ThemeTextSubtleBrush}" Margin="0,0,0,6"/>
                                <ComboBox x:Name="YearCombo" Height="38" FontSize="13"
                                          SelectionChanged="SortFilter_Changed"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="ТИП ПРОДАЖИ" FontSize="11" FontWeight="Black"
                                           Foreground="{DynamicResource ThemeTextSubtleBrush}" Margin="0,0,0,6"/>
                                <ComboBox x:Name="SaleTypeCombo" Height="38" FontSize="13"
                                          SelectionChanged="SortFilter_Changed">
                                    <ComboBoxItem Content="все" Tag="All" IsSelected="True"/>
                                    <ComboBoxItem Content="только пробные" Tag="TrialOnly"/>
                                    <ComboBoxItem Content="без пробных" Tag="OtherOnly"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Список -->
                <Border Background="{DynamicResource ThemeSurfaceBrush}" CornerRadius="20" ClipToBounds="True"
                        BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Padding="0">
                    <Border.Effect>
                        <DropShadowEffect Color="{DynamicResource ThemeShadowColor}" BlurRadius="32"
                                          ShadowDepth="12" Opacity="0.05"/>
                    </Border.Effect>
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Padding="20,14"
                                BorderBrush="{DynamicResource ThemeGridLineBrush}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Список продаж" FontSize="15"
                                               FontWeight="ExtraBold" Foreground="{DynamicResource ThemeTextBrush}"/>
                                    <TextBlock x:Name="SalesCountText"
                                               Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="11"
                                               FontWeight="SemiBold" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <DataGrid x:Name="SalesGrid"
                                  Style="{StaticResource ModernDataGridStyle}"
                                  MinHeight="380" MaxHeight="600"
                                  MouseDoubleClick="SalesGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ДАТА" Binding="{Binding SaleDateText}" Width="100"/>
                                <DataGridTextColumn Header="ТИП" Binding="{Binding SaleTypeText}" Width="140"/>
                                <DataGridTextColumn Header="КЛИЕНТ" Binding="{Binding ClientFullNameText}" Width="2*"/>
                                <DataGridTextColumn Header="НАИМЕНОВАНИЕ" Binding="{Binding ItemName}" Width="2*"/>
                                <DataGridTextColumn Header="КОЛ-ВО" Binding="{Binding Quantity}" Width="80"/>
                                <DataGridTextColumn Header="ЦЕНА" Binding="{Binding UnitPriceText}" Width="110"/>
                                <DataGridTextColumn Header="СУММА" Binding="{Binding TotalAmountText}" Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="СПОСОБ" Binding="{Binding PaymentMethodNameText}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <Border Background="{DynamicResource ThemeSurfaceBrush}" CornerRadius="20" Padding="20" Margin="0,16,0,0"
                        BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="✏  Редактировать"
                                Click="EditSale_Click"
                                Style="{StaticResource HeaderButtonStyle}"/>
                        <Button x:Name="DeleteSaleButton" Content="🗑  Удалить"
                                Click="DeleteSale_Click"
                                Style="{StaticResource HeaderButtonStyle}"/>
                    </StackPanel>
                </Border>

                <Border x:Name="ErrorBorder" Background="#FF6B6B" CornerRadius="12"
                        Padding="14,10" Margin="0,16,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ThemeDangerFgBrush}"
                               FontWeight="SemiBold" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
