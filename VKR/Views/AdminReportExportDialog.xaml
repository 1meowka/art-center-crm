<Window x:Class="VKR.Views.AdminReportExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Учебный год"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource ThemeBgBrush}"
        FontFamily="Segoe UI">
    <Border Background="{DynamicResource ThemeSurfaceBrush}" CornerRadius="24"
            BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
            Margin="16" Padding="24">
        <StackPanel>
            <TextBlock Text="Учебный год в Excel" FontSize="20" FontWeight="ExtraBold"
                       Foreground="{DynamicResource ThemeTextBrush}"/>
            <TextBlock Text="Один файл: свод по направлениям (авг—май), источники прихода, группы, лагерь"
                       FontSize="13" Foreground="{DynamicResource ThemeTextMutedBrush}"
                       TextWrapping="Wrap" Margin="0,8,0,20"/>

            <TextBlock Text="ПЕРИОД ДЛЯ ЗАЯВОК И ЛАГЕРЯ" FontSize="11" FontWeight="Black"
                       Foreground="{DynamicResource ThemeTextSubtleBrush}" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <DatePicker x:Name="DateFromPicker" Width="200" Height="38"/>
                <TextBlock Text="—" Margin="10,0" VerticalAlignment="Center"/>
                <DatePicker x:Name="DateToPicker" Width="200" Height="38"/>
            </StackPanel>

            <TextBlock Text="УЧЕБНЫЙ ГОД ДЛЯ ГРУПП" FontSize="11" FontWeight="Black"
                       Foreground="{DynamicResource ThemeTextSubtleBrush}" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <ComboBox x:Name="YearComboBox" Width="120" Height="38" VerticalContentAlignment="Center"/>
                <TextBlock x:Name="YearEndText" VerticalAlignment="Center" Margin="10,0,0,0"
                           Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="14"/>
            </StackPanel>

            <TextBlock x:Name="StatusText" FontSize="12" Foreground="{DynamicResource ThemeTextMutedBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,12"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" Width="120" Height="42" Margin="0,0,8,0"
                        Click="CancelButton_Click"/>
                <Button Content="Выгрузить" Width="140" Height="42"
                        Background="{DynamicResource ThemePrimaryBrush}"
                        Foreground="{DynamicResource ThemeOnPrimaryBrush}"
                        FontWeight="Bold" BorderThickness="0"
                        Click="ExportButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
