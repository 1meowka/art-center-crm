<Window x:Class="VKR.Views.TeacherGroupsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Группы преподавателя" Width="700" Height="500"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent" AllowsTransparency="True"
        FontFamily="Segoe UI">
    <Border Background="{DynamicResource ThemeSurfaceBrush}" CornerRadius="20" Margin="12" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1">
        <Border.Effect><DropShadowEffect Color="{DynamicResource ThemeShadowColor}" BlurRadius="40" ShadowDepth="12" Opacity="0.25"/></Border.Effect>
        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Группы преподавателя" FontSize="22" FontWeight="ExtraBold" Foreground="{DynamicResource ThemeTextBrush}"/>
                    <TextBlock x:Name="TeacherNameText" FontSize="13" Foreground="{DynamicResource ThemeTextMutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top" Width="32" Height="32"
                        Background="{DynamicResource ThemeBgBrush}" Foreground="{DynamicResource ThemeTextMutedBrush}" BorderThickness="0" Cursor="Hand" Click="Close_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="14">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/></Trigger></ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <Border Grid.Row="1" CornerRadius="12" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" ClipToBounds="True">
                <DataGrid x:Name="GroupsGrid" Background="{DynamicResource ThemeSurfaceBrush}" BorderThickness="0" HeadersVisibility="Column"
                          GridLinesVisibility="None" HorizontalGridLinesBrush="{DynamicResource ThemeGridLineBrush}"
                          RowHeight="24" ColumnHeaderHeight="24" AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                          AlternatingRowBackground="{DynamicResource ThemeSurfaceBrush}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ГРУППА" Binding="{Binding Title}" Width="2*"/>
                        <DataGridTextColumn Header="УЧЕНИКОВ" Binding="{Binding StudentsText}" Width="*"/>
                        <DataGridTextColumn Header="ЗАНЯТИЙ/НЕД." Binding="{Binding LessonsPerWeek}" Width="*"/>
                        <DataGridTextColumn Header="СТАТУС" Binding="{Binding StatusText}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Button Grid.Row="2" Content="Закрыть" Width="120" Height="42" HorizontalAlignment="Right" Margin="0,16,0,0"
                    Background="{DynamicResource ThemePrimaryBrush}" Foreground="{DynamicResource ThemeOnPrimaryBrush}" BorderThickness="0" FontWeight="Bold" FontSize="13" Cursor="Hand" Click="Close_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="14"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemePrimaryHoverBrush}"/></Trigger></ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</Window>
