<Window x:Class="VKR.Views.ContractEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Договор"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource ThemeBgBrush}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="HeaderButtonStyle" TargetType="Button" BasedOn="{StaticResource SectionHeaderButtonStyle}"/>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SectionPrimaryButtonStyle}"/>

        <Style x:Key="RoundedTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NoteTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="MinHeight" Value="72"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource ThemeBgBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Stretch"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSubtleBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource ThemeHeaderBrush}"
                BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="24,12,24,12">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ДОГОВОР" FontSize="11" FontWeight="Black"
                               Foreground="{DynamicResource ThemeTextSubtleBrush}"/>
                    <TextBlock x:Name="TitleText" Text="Новый договор" FontSize="20"
                               FontWeight="ExtraBold" Foreground="{DynamicResource ThemeTextBrush}"/>
                </StackPanel>
                <Button Content="← Закрыть" Style="{StaticResource HeaderButtonStyle}"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Click="Cancel_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="10"/>
            </Grid.RowDefinitions>

            <!-- Левая колонка: реквизиты -->
            <Border Grid.Row="0" Grid.RowSpan="8" Grid.Column="0"
                    Background="{DynamicResource ThemeSurfaceBrush}" CornerRadius="16" Padding="18"
                    BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                    IsHitTestVisible="False"/>
            <!-- Правая колонка: условия -->
            <Border Grid.Row="0" Grid.RowSpan="8" Grid.Column="2"
                    Background="{DynamicResource ThemeSurfaceBrush}" CornerRadius="16" Padding="18"
                    BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                    IsHitTestVisible="False"/>

            <Grid Grid.Row="0" Grid.Column="0" Margin="18,18,18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="№ ДОГОВОРА" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="NumberBox" Style="{StaticResource RoundedTextBoxStyle}"
                             IsReadOnly="True"
                             ToolTip="Номер совпадает с id в базе и назначается при сохранении"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="ДАТА ЗАКЛЮЧЕНИЯ" Style="{StaticResource FieldLabelStyle}"/>
                    <DatePicker x:Name="ContractDatePicker" Height="34"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="ФИЛИАЛ" Style="{StaticResource FieldLabelStyle}"/>
                    <ComboBox x:Name="BranchCombo"
                              Style="{StaticResource RoundedComboBoxStyle}"
                              DisplayMemberPath="ButtonLabel"
                              SelectedValuePath="IdBranch"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="0" Grid.Column="2" Margin="18,18,18,0">
                <TextBlock Text="ТИП ОБУЧАЮЩЕГОСЯ" Style="{StaticResource FieldLabelStyle}"/>
                <ComboBox x:Name="StudentTypeCombo"
                          Style="{StaticResource RoundedComboBoxStyle}"
                          DisplayMemberPath="Name" SelectedValuePath="Id"/>
                <TextBlock x:Name="StudentTypeLegendText" Visibility="Collapsed"/>
                <ItemsControl x:Name="StudentTypeLegendItems" Visibility="Collapsed"/>
            </StackPanel>

            <Grid Grid.Row="2" Grid.Column="0" Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="НАПРАВЛЕНИЕ" Style="{StaticResource FieldLabelStyle}"/>
                    <ComboBox x:Name="DirectionCombo"
                              Style="{StaticResource RoundedComboBoxStyle}"
                              DisplayMemberPath="Name" SelectedValuePath="Id"
                              SelectionChanged="DirectionCombo_SelectionChanged"/>
                </StackPanel>
                <StackPanel x:Name="CourseVariantPanel" Grid.Column="2">
                    <TextBlock Text="КУРС / ДЛИТЕЛЬНОСТЬ" Style="{StaticResource FieldLabelStyle}"/>
                    <ComboBox x:Name="CourseVariantCombo"
                              Style="{StaticResource RoundedComboBoxStyle}"
                              DisplayMemberPath="DisplayName"
                              SelectionChanged="CourseVariantCombo_SelectionChanged"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2" Grid.Column="2" Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="СУММА БЕЗ СКИДКИ" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="PriceBox" Style="{StaticResource RoundedTextBoxStyle}" Text="0"
                             TextChanged="PricingField_Changed"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="СУММА ДОГОВОРА" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="TotalBox" Style="{StaticResource RoundedTextBoxStyle}" Text="0" IsReadOnly="True"
                             Background="{DynamicResource ThemeBgBrush}"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="4" Grid.Column="0" Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="ДЛИТЕЛЬНОСТЬ" Style="{StaticResource FieldLabelStyle}"/>
                    <Border Background="{DynamicResource ThemeBgBrush}" CornerRadius="10" Height="34" Padding="10,0">
                        <TextBlock x:Name="CourseDurationText" VerticalAlignment="Center"
                                   FontSize="13" FontWeight="SemiBold" Text="—"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="ЗАНЯТИЙ" Style="{StaticResource FieldLabelStyle}"/>
                    <Border Background="{DynamicResource ThemeBgBrush}" CornerRadius="10" Height="34" Padding="10,0">
                        <TextBlock x:Name="CourseLessonsText" VerticalAlignment="Center"
                                   FontSize="13" FontWeight="SemiBold" Text="—"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="РАЗ В НЕДЕЛЮ" Style="{StaticResource FieldLabelStyle}"/>
                    <Border Background="{DynamicResource ThemeBgBrush}" CornerRadius="10" Height="34" Padding="10,0">
                        <TextBlock x:Name="CourseTimesPerWeekText" VerticalAlignment="Center"
                                   FontSize="13" FontWeight="SemiBold" Text="—"/>
                    </Border>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="4" Grid.Column="2" Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="СКИДКА, %" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="DiscountPercentBox" Style="{StaticResource RoundedTextBoxStyle}" Text=""
                             TextChanged="PricingField_Changed"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="СКИДКА, ₽" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="DiscountAmountBox" Style="{StaticResource RoundedTextBoxStyle}" Text=""
                             TextChanged="PricingField_Changed"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="СТАТУС" Style="{StaticResource FieldLabelStyle}"/>
                    <ComboBox x:Name="StatusCombo"
                              Style="{StaticResource RoundedComboBoxStyle}"
                              SelectedIndex="0">
                        <ComboBoxItem Content="активен"/>
                        <ComboBoxItem Content="завершен"/>
                        <ComboBoxItem Content="расторгнут"/>
                        <ComboBoxItem Content="архивный"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="6" Grid.Column="0" Margin="18,0,18,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="ДАТА НАЧАЛА" Style="{StaticResource FieldLabelStyle}"/>
                        <DatePicker x:Name="StartDatePicker" Height="34"
                                  SelectedDateChanged="StartDatePicker_SelectedDateChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="ДАТА ОКОНЧАНИЯ" Style="{StaticResource FieldLabelStyle}"/>
                        <DatePicker x:Name="EndDatePicker" Height="34"/>
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Row="1" Margin="0,12,0,0">
                    <TextBlock Text="ОБУЧАЮЩИЙСЯ — НА НЕГО ЗАКЛЮЧАЕТСЯ ДОГОВОР" Style="{StaticResource FieldLabelStyle}"/>
                    <Grid>
                        <TextBox x:Name="StudentSearchBox"
                                 Style="{StaticResource RoundedTextBoxStyle}"
                                 ToolTip="Начните вводить ФИО или телефон — откроется список"
                                 TextChanged="StudentSearchBox_TextChanged"
                                 GotFocus="StudentSearchBox_GotFocus"
                                 LostFocus="StudentSearchBox_LostFocus"
                                 PreviewKeyDown="StudentSearchBox_PreviewKeyDown"/>
                        <TextBlock x:Name="StudentSearchPlaceholder"
                                   Text="Начните вводить ФИО..."
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center"
                                   Margin="14,0,34,0"
                                   FontSize="13"
                                   Foreground="{DynamicResource ThemeTextSubtleBrush}"/>
                        <Popup x:Name="StudentDropDown"
                               PlacementTarget="{Binding ElementName=StudentSearchBox}"
                               Placement="Bottom"
                               StaysOpen="True"
                               AllowsTransparency="True"
                               PopupAnimation="Slide">
                            <Border Background="{DynamicResource ThemeSurfaceBrush}"
                                    BorderBrush="{DynamicResource ThemeBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="4"
                                    MinWidth="280">
                                <Border.Effect>
                                    <DropShadowEffect Color="{DynamicResource ThemeShadowColor}" BlurRadius="20"
                                                      ShadowDepth="4" Opacity="0.12"/>
                                </Border.Effect>
                                <ListBox x:Name="StudentResultsList"
                                         DisplayMemberPath="Name"
                                         MaxHeight="260"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         SelectionChanged="StudentResultsList_SelectionChanged"/>
                            </Border>
                        </Popup>
                    </Grid>
                    <TextBlock Text="РОДИТЕЛЬ ИЗ КАРТОЧКИ" Style="{StaticResource FieldLabelStyle}"
                               Margin="0,12,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="PayerCombo"
                                  Style="{StaticResource RoundedComboBoxStyle}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  ToolTip="Для ребёнка выберите маму, папу или другого взрослого из его карточки. Договор оформляется на ребёнка."/>
                        <Button Grid.Column="2" Content="Другой"
                                Style="{StaticResource HeaderButtonStyle}"
                                Margin="0"
                                Padding="12,8"
                                Click="PickPayer_Click"/>
                    </Grid>
                    <TextBlock x:Name="PartyHintText"
                               Text="Договор заключается на обучающегося. Для ребёнка выберите родителя из его карточки."
                               FontSize="11"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource ThemeTextMutedBrush}"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="6" Grid.RowSpan="2" Grid.Column="2" Margin="18,0,18,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="ПРИМЕЧАНИЕ ПО ДОГОВОРУ" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox x:Name="CommentBox" Grid.Row="1" Style="{StaticResource NoteTextBoxStyle}"/>
                <Border x:Name="ErrorBorder" Grid.Row="2" Background="#FF6B6B" CornerRadius="10"
                        Padding="12,8" Margin="0,10,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ThemeDangerFgBrush}"
                               FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </Border>
            </Grid>

        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource ThemeSurfaceBrush}"
                BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,1,0,0" Padding="24,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена" Style="{StaticResource HeaderButtonStyle}" Click="Cancel_Click"/>
            <Button Content="Сохранить" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0" Click="Save_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
