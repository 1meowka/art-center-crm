<Window x:Class="VKR.Views.TrialFollowupCompleteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Задача после пробного"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent" AllowsTransparency="True"
        FontFamily="Segoe UI">
    <Border Background="{DynamicResource ThemeSurfaceBrush}" CornerRadius="16" Margin="10"
            BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Padding="24">
        <StackPanel>
            <TextBlock Text="Обработка задачи" FontSize="20" FontWeight="ExtraBold"/>
            <TextBlock x:Name="SummaryText" FontSize="13" Foreground="{DynamicResource ThemeTextMutedBrush}"
                       TextWrapping="Wrap" Margin="0,6,0,14"/>

            <TextBlock Text="СВЯЗЬ С КЛИЕНТОМ" FontSize="11" FontWeight="Black"
                       Foreground="{DynamicResource ThemeTextSubtleBrush}" Margin="0,0,0,6"/>
            <ComboBox x:Name="ContactStatusCombo" Height="38" FontSize="13" Margin="0,0,0,12"/>

            <TextBlock Text="РЕЗУЛЬТАТ ПРОБНОГО" FontSize="11" FontWeight="Black"
                       Foreground="{DynamicResource ThemeTextSubtleBrush}" Margin="0,0,0,6"/>
            <ComboBox x:Name="ResultCombo" Height="38" FontSize="13" Margin="0,0,0,12"/>

            <CheckBox x:Name="OnControlCheckBox" Content="Поставить клиента на контроль (повторный звонок)"
                      FontSize="13" Margin="0,0,0,12"/>

            <TextBlock Text="КОММЕНТАРИЙ" FontSize="11" FontWeight="Black"
                       Foreground="{DynamicResource ThemeTextSubtleBrush}" Margin="0,0,0,6"/>
            <TextBox x:Name="CommentBox" Height="72" Padding="10,8" TextWrapping="Wrap"
                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontSize="13"/>

            <TextBlock x:Name="ErrorText" Foreground="#E11D48" TextWrapping="Wrap"
                       Visibility="Collapsed" Margin="0,10,0,0"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Отмена" Width="110" Height="38" Margin="0,0,8,0"
                        Style="{StaticResource SectionHeaderButtonStyle}" Click="Cancel_Click"/>
                <Button Content="Сохранить" Width="130" Height="38"
                        Style="{StaticResource SectionPrimaryButtonStyle}" Click="Save_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
