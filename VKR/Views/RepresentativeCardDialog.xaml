<Window x:Class="VKR.Views.RepresentativeCardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Карточка представителя"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource ThemeBgBrush}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="HeaderButtonStyle" TargetType="Button" BasedOn="{StaticResource SectionHeaderButtonStyle}"/>

        <Style x:Key="ModernDataGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource ThemeGridLineBrush}"/>
            <Setter Property="RowHeight" Value="24"/>
            <Setter Property="ColumnHeaderHeight" Value="24"/>
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource ThemeSurfaceBrush}"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource ThemeHoverSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextMutedBrush}"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Padding" Value="6,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource ThemeHeaderBrush}"
                BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="28,16,28,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Resources/logo.png" Width="44" Height="44" Margin="0,0,14,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="КАРТОЧКА" FontSize="11" FontWeight="Black"
                                   Foreground="{DynamicResource ThemeTextSubtleBrush}"/>
                        <TextBlock x:Name="TitleText" Text="Представитель" FontSize="22" FontWeight="ExtraBold"
                                   Foreground="{DynamicResource ThemeTextBrush}" Margin="0,2,0,0"/>
                        <TextBlock x:Name="SubtitleText" Foreground="{DynamicResource ThemeTextMutedBrush}"
                                   FontSize="13" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Button Content="← Закрыть" Style="{StaticResource HeaderButtonStyle}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="Close_Click"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,20,28,20">
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <UniformGrid Columns="2" Rows="8">
                        <TextBlock Text="ФИО" Foreground="{DynamicResource ThemeTextMutedBrush}"/>
                        <TextBlock x:Name="FioText" FontWeight="SemiBold"/>
                        <TextBlock Text="Телефон" Foreground="{DynamicResource ThemeTextMutedBrush}"/>
                        <TextBlock x:Name="PhoneText"/>
                        <TextBlock Text="Email" Foreground="{DynamicResource ThemeTextMutedBrush}"/>
                        <TextBlock x:Name="EmailText"/>
                        <TextBlock Text="Возраст" Foreground="{DynamicResource ThemeTextMutedBrush}"/>
                        <TextBlock x:Name="AgeText"/>
                        <TextBlock Text="Место работы" Foreground="{DynamicResource ThemeTextMutedBrush}"/>
                        <TextBlock x:Name="WorkplaceText" TextWrapping="Wrap"/>
                        <TextBlock Text="Адрес проживания" Foreground="{DynamicResource ThemeTextMutedBrush}"/>
                        <TextBlock x:Name="ResidenceAddressText" TextWrapping="Wrap"/>
                        <TextBlock Text="Комментарий" Foreground="{DynamicResource ThemeTextMutedBrush}"/>
                        <TextBlock x:Name="CommentText" TextWrapping="Wrap"/>
                        <TextBlock Text="В системе с" Foreground="{DynamicResource ThemeTextMutedBrush}"/>
                        <TextBlock x:Name="CreatedText"/>
                    </UniformGrid>
                </Border>

                <Border Style="{StaticResource Card}" MinHeight="420">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                            <TextBlock Text="Связанные обучающиеся" FontSize="18" FontWeight="ExtraBold"
                                       Foreground="{DynamicResource ThemeTextBrush}"/>
                            <TextBlock Text="Двойной клик по строке откроет карточку обучающегося."
                                       Foreground="{DynamicResource ThemeTextMutedBrush}"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                        <DataGrid x:Name="ChildrenGrid" Style="{StaticResource ModernDataGridStyle}"
                                  MouseDoubleClick="ChildrenGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ОБУЧАЮЩИЙСЯ" Binding="{Binding StudentFullName}" Width="2*"/>
                                <DataGridTextColumn Header="ВОЗРАСТ" Binding="{Binding Age}" Width="80"/>
                                <DataGridTextColumn Header="РОЛЬ" Binding="{Binding RepresentativeRoleText}" Width="*"/>
                                <DataGridTextColumn Header="ПЛАТЕЛЬЩИК" Binding="{Binding MainPayerText}" Width="150"/>
                                <DataGridTextColumn Header="ЗАКОННЫЙ" Binding="{Binding LegalText}" Width="160"/>
                                <DataGridTextColumn Header="СТАТУС" Binding="{Binding Status}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" x:Name="ErrorBorder" Background="#FF6B6B" Margin="28,0,28,16"
                Padding="16,12" Visibility="Collapsed">
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ThemeDangerFgBrush}"
                       FontWeight="SemiBold" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
