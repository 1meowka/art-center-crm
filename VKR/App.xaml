<Application x:Class="VKR.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:local="clr-namespace:VKR"
             StartupUri="Views/LoginWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <sys:Double x:Key="AppFontSize">13</sys:Double>
            <sys:Double x:Key="AppFontSizeCaption">12</sys:Double>
            <sys:Double x:Key="AppFontSizeGrid">11</sys:Double>
            <sys:Double x:Key="AppFontSizeGridHeader">10</sys:Double>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/ThemeDefault.xaml"/>
                <ResourceDictionary Source="/Resources/AppStyles.xaml"/>
                <ResourceDictionary Source="/Resources/SectionWindowStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
